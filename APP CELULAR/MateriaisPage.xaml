<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="APP_CELULAR.MateriaisPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5F6FA"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- CABEÇALHO -->
        <Border
            Grid.Row="0"
            BackgroundColor="#2E2A6A"
            StrokeThickness="0"
            Padding="22,20,22,24">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,28,28" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto,Auto">

                <!-- LINHA SUPERIOR -->
                <Grid ColumnDefinitions="50,*,50">

                    <!-- VOLTAR -->
                    <Border
                        Grid.Column="0"
                        HeightRequest="44"
                        WidthRequest="44"
                        BackgroundColor="#5562FF"
                        StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Button
                            Grid.Column="0"
                            Text="‹"
                            FontSize="36"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            Padding="0"
                            HeightRequest="44"
                            WidthRequest="44"
                            Clicked="Voltar_Clicked" />

                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2"
                        HorizontalOptions="Center">

                        <Label
                            Text="MATERIAIS"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#BDB8F5"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Cadastro de materiais"
                            FontSize="21"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                    <!-- CONTADOR -->
                    <Border
                        Grid.Column="2"
                        HeightRequest="44"
                        WidthRequest="44"
                        BackgroundColor="#FF5562FF"
                        StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Label
                            x:Name="QuantidadeLabel"
                            Text="0"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                    </Border>

                </Grid>

                <!-- DESCRIÇÃO -->
                <Label
                    Grid.Row="1"
                    Text="Cadastre e gerencie os materiais utilizados no sistema."
                    FontSize="14"
                    TextColor="#DAD8F5"
                    HorizontalTextAlignment="Center"
                    Margin="0,16,0,0" />

            </Grid>

        </Border>


        <!-- PESQUISA -->
        <Border
            Grid.Row="1"
            Margin="20,-22,20,0"
            BackgroundColor="White"
            StrokeThickness="0"
            Padding="15,5">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="35,*">

                <Label
                    Grid.Column="0"
                    Text="⌕"
                    FontSize="28"
                    TextColor="#777777"
                    VerticalTextAlignment="Center"
                    HorizontalTextAlignment="Center" />

                <Entry
                    Grid.Column="1"
                    x:Name="PesquisaEntry"
                    Placeholder="Pesquisar material..."
                    PlaceholderColor="#999999"
                    TextColor="#222222"
                    FontSize="15"
                    BackgroundColor="Transparent"
                    TextChanged="Pesquisa_TextChanged" />

            </Grid>

        </Border>


        <!-- LISTA -->
        <CollectionView
            Grid.Row="2"
            x:Name="MateriaisCollection"
            Margin="20,25,20,90"
            SelectionMode="None">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="12">

                    <Label
                        Text="♻"
                        FontSize="55"
                        HorizontalTextAlignment="Center"
                        TextColor="#C9C9D8" />

                    <Label
                        Text="Nenhum material cadastrado"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="#555555"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Toque no botão + para cadastrar o primeiro material."
                        FontSize="13"
                        TextColor="#888888"
                        HorizontalTextAlignment="Center"
                        MaximumWidthRequest="280" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>


            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="16"
                        Margin="0,0,0,12">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="55,*,Auto">

                            <!-- ÍCONE -->
                            <Border
                                Grid.Column="0"
                                HeightRequest="48"
                                WidthRequest="48"
                                BackgroundColor="#EEEAFB"
                                StrokeThickness="0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="15" />
                                </Border.StrokeShape>

                                <Label
                                    Text="♻"
                                    FontSize="25"
                                    TextColor="#2E2A6A"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                            </Border>


                            <!-- INFORMAÇÕES -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                Margin="12,0,5,0"
                                VerticalOptions="Center"
                                Spacing="3">

                                <Label
                                    Text="{Binding Nome}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="#222222"
                                    LineBreakMode="TailTruncation" />

                                <Label
                                    Text="{Binding Unidade, StringFormat='Unidade: {0}'}"
                                    FontSize="13"
                                    TextColor="#777777" />

                                <Label
                                    Text="{Binding EstoqueAtual, StringFormat='Estoque: {0:N2}'}"
                                    FontSize="13"
                                    TextColor="#2E2A6A" />

                            </VerticalStackLayout>


                            <!-- MENU -->
                            <Label
                                Grid.Column="2"
                                Text="⋮"
                                FontSize="27"
                                TextColor="#777777"
                                VerticalTextAlignment="Center">

                                <Label.GestureRecognizers>

                                    <TapGestureRecognizer
                                        Tapped="MenuMaterial_Clicked"
                                        CommandParameter="{Binding .}" />

                                </Label.GestureRecognizers>

                            </Label>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>


        <!-- BOTÃO ADICIONAR -->
        <Border
            Grid.Row="2"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,25,25"
            HeightRequest="62"
            WidthRequest="62"
            BackgroundColor="#2E2A6A"
            StrokeThickness="0">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>

            <Label
                Text="+"
                FontSize="34"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center">

                <Label.GestureRecognizers>

                    <TapGestureRecognizer
                        Tapped="Adicionar_Clicked" />

                </Label.GestureRecognizers>

            </Label>

        </Border>

    </Grid>

</ContentPage>