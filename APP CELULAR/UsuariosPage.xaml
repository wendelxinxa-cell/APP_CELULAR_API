<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP_CELULAR.UsuariosPage"
             BackgroundColor="{DynamicResource BrandBackground}"
             Title="Usuários">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- CABEÇALHO -->
        <Grid Grid.Row="0"
              BackgroundColor="{DynamicResource BrandPrimary}"
              Padding="20,18"
              ColumnDefinitions="Auto,*">

            <Button Grid.Column="0"
                    Text="‹"
                    FontSize="34"
                    TextColor="{DynamicResource BrandOnPrimary}"
                    BackgroundColor="Transparent"
                    WidthRequest="45"
                    HeightRequest="45"
                    Padding="0"
                    Clicked="Voltar_Clicked" />

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="2"
                                 VerticalOptions="Center">

                <Label Text="USUÁRIOS"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource BrandOnPrimary}" />

                <Label x:Name="SubtituloLabel"
                       Text="Usuários cadastrados"
                       FontSize="13"
                       TextColor="{DynamicResource BrandOnPrimary}" />

            </VerticalStackLayout>

        </Grid>


        <!-- LISTA -->
        <RefreshView Grid.Row="1"
                     x:Name="RefreshUsuarios"
                     Refreshing="RefreshUsuarios_Refreshing">

            <CollectionView x:Name="UsuariosCollection"
                            SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="30"
                                         Spacing="12"
                                         VerticalOptions="Center">

                        <Label Text="👤"
                               FontSize="55"
                               HorizontalOptions="Center" />

                        <Label Text="Nenhum usuário cadastrado."
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource BrandMuted}"
                               HorizontalOptions="Center" />

                    </VerticalStackLayout>
                </CollectionView.EmptyView>


                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Frame Margin="14,7"
                               Padding="0"
                               CornerRadius="16"
                               HasShadow="True"
                               BackgroundColor="{DynamicResource BrandSurface}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Usuario_Tocado" />
                            </Frame.GestureRecognizers>

                            <Grid Padding="16"
                                  ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="14">

                                <!-- ÍCONE -->
                                <Border Grid.Column="0"
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        StrokeThickness="0"
                                        BackgroundColor="{DynamicResource BrandSoft}"
                                        StrokeShape="RoundRectangle 26">

                                    <Label Text="👤"
                                           FontSize="25"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />

                                </Border>


                                <!-- DADOS -->
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="3">

                                    <Label Text="{Binding Nome}"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource BrandText}"
                                           LineBreakMode="TailTruncation" />

                                    <Label Text="{Binding Funcao}"
                                           FontSize="13"
                                           TextColor="{DynamicResource BrandMuted}" />

                                    <Label Text="{Binding Email}"
                                           FontSize="12"
                                           TextColor="{DynamicResource BrandMuted}"
                                           LineBreakMode="TailTruncation" />

                                    <Label Text="{Binding EmpresaExibida}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource BrandPrimary}"
                                           LineBreakMode="TailTruncation" />

                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Border WidthRequest="10" HeightRequest="10" BackgroundColor="{Binding CorStatusAcesso}" StrokeThickness="0" VerticalOptions="Center">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="5" /></Border.StrokeShape>
                                        </Border>
                                        <Label Text="{Binding StatusAcesso}" FontSize="11" FontAttributes="Bold" TextColor="{Binding CorStatusAcesso}" LineBreakMode="WordWrap" />
                                    </HorizontalStackLayout>

                                    <Label Text="ADMINISTRADOR MASTER"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource BrandPrimary}"
                                           IsVisible="{Binding EhMaster}" />

                                </VerticalStackLayout>


                                <!-- SETA -->
                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="30"
                                       TextColor="{DynamicResource BrandMuted}"
                                       VerticalOptions="Center" />

                            </Grid>

                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>


        <!-- BOTÃO NOVO -->
        <VerticalStackLayout Grid.Row="2"
                             Padding="16,8,16,16"
                             Spacing="8"
                             BackgroundColor="{DynamicResource BrandBackground}">
            <Button x:Name="BtnAprovacoes"
                    Text="APROVAR USUÁRIOS E APARELHOS"
                    FontSize="14"
                    FontAttributes="Bold"
                    BackgroundColor="{DynamicResource BrandSoft}"
                    TextColor="{DynamicResource BrandPrimary}"
                    CornerRadius="22"
                    HeightRequest="46"
                    Clicked="Aprovacoes_Clicked" />
            <Button x:Name="BtnNovoUsuario"
                    Text="+  NOVO USUÁRIO"
                    FontSize="16"
                    FontAttributes="Bold"
                    BackgroundColor="{DynamicResource BrandPrimary}"
                    TextColor="{DynamicResource BrandOnPrimary}"
                    CornerRadius="25"
                    HeightRequest="52"
                    Clicked="NovoUsuario_Clicked" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
