<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net9.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>APP_CELULAR</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- O aplicativo ainda usa DataTemplates sem x:DataType em telas legadas.
		     Esses avisos de performance não indicam falha de XAML e não devem
		     esconder erros reais durante a publicação. -->
		<NoWarn>$(NoWarn);XC0022;CS0618</NoWarn>

		<!-- Display name -->
		<ApplicationTitle>CATCHAT</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.appcelular</ApplicationId>

		<!-- Versions -->
		<!-- O build exibido reinicia em cada versão; ApplicationVersion continua crescente no Android. -->
		<ChatCatReleaseBuild>41</ChatCatReleaseBuild>
		<ApplicationDisplayVersion>0.0.001</ApplicationDisplayVersion>
		<ApplicationVersion>44</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
		<AndroidSigningKeyStore>appcelular.keystore</AndroidSigningKeyStore>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-android|AnyCPU'">
	  <AndroidPackageFormat>apk</AndroidPackageFormat>
	  <AndroidKeyStore>True</AndroidKeyStore>
	  <AndroidSigningStorePass>12345678</AndroidSigningStorePass>
	  <AndroidSigningKeyAlias>appwendel</AndroidSigningKeyAlias>
	  <AndroidSigningKeyPass>12345678</AndroidSigningKeyPass>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-android|AnyCPU'">
	  <AndroidKeyStore>True</AndroidKeyStore>
	  <AndroidSigningStorePass>12345678</AndroidSigningStorePass>
	  <AndroidSigningKeyAlias>appwendel</AndroidSigningKeyAlias>
	  <AndroidSigningKeyPass>12345678</AndroidSigningKeyPass>
	  <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyMetadata Include="ChatCatReleaseBuild" Value="$(ChatCatReleaseBuild)" />
	</ItemGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Images\catchat_login.png" Color="#140723" BaseSize="220,220" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="WebPrototype\**\*.cs" />
	  <Compile Remove="MateriaisPage.cs" />
	  <Compile Remove="NewPage1.xaml.cs" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Remove="NewPage1.xaml" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.8" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.8" />
		<PackageReference Include="Plugin.Maui.Biometric" Version="0.0.8" />
		<PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="ControleChequesPage.xaml.cs">
	    <DependentUpon>ControleChequesPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="NovaCompraPage.xaml.cs">
	    <DependentUpon>NovaCompraPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="NovaVendaPage.xaml.cs">
	    <DependentUpon>NovaVendaPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="FigurinhasStipopPage.xaml.cs">
	    <DependentUpon>FigurinhasStipopPage.xaml</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="App.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml>
	  <MauiXaml Update="AppShell.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml>
	  <MauiXaml Update="ConfiguracoesPage.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml>
	  <MauiXaml Update="ConversasPage.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml>
	  <MauiXaml Update="ChatZeusPage.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml>
	  <MauiXaml Update="EmpresasPage.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml>
	  <MauiXaml Update="ChatPage.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml>
	  <MauiXaml Update="FigurinhasStipopPage.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml>
	  <MauiXaml Update="ApiEndpointPage.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml>
	  <MauiXaml Update="ChequesClientePage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="ComprasPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="DetalhaUsuariosPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="DetalhesCompraPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="ControleChequesPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="MediaViewer.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="NovaCompraPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="DetalhesVendaPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="MateriaisPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="NovoUsuarioPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="PessoasPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="NovaVendaPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="UsuariosPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="VendasPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

</Project>


