<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP_CELULAR.MediaViewer"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Black"
             Padding="0">
    <Grid BackgroundColor="Black">
        <Image x:Name="FotoViewer" IsVisible="False" Aspect="AspectFit" HorizontalOptions="Fill" VerticalOptions="Fill" />
        <WebView x:Name="VideoViewer" IsVisible="False" HorizontalOptions="Fill" VerticalOptions="Fill" />
        <Button Text="✕" Clicked="Fechar_Clicked" SemanticProperties.Description="Fechar visualização"
                HorizontalOptions="End" VerticalOptions="Start" Margin="12,24,12,12"
                WidthRequest="46" HeightRequest="46" CornerRadius="23"
                BackgroundColor="#99000000" TextColor="White" FontSize="20" ZIndex="1" />
    </Grid>
</ContentPage>
