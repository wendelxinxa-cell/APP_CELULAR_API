<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="APP_CELULAR.MainPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource BrandBackground}">
    <Grid RowDefinitions="Auto,*">

        <!-- ================================================= -->
        <!-- CABEÇALHO -->
        <!-- ================================================= -->

        <Border Grid.Row="0"
                BackgroundColor="{DynamicResource BrandPrimary}"
                StrokeThickness="0"
                Padding="22,18,22,22">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,28,28" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="*,Auto"
                  RowSpacing="20">

                <!-- Logo / nome -->
                <VerticalStackLayout Grid.Row="0"
                                     Grid.Column="0"
                                     Spacing="2">

                    <Label Text="CATCHAT"
                           TextColor="{DynamicResource BrandOnPrimary}"
                           FontSize="13"
                           FontAttributes="Bold"
                           CharacterSpacing="1.5" />

                    <Label x:Name="PainelSubtitleLabel" Text="Painel principal"
                           TextColor="{DynamicResource BrandOnPrimary}"
                           FontSize="13" />

                </VerticalStackLayout>

                <!-- Botões do cabeçalho -->
                <HorizontalStackLayout Grid.Row="0"
                                       Grid.Column="1"
                                       Spacing="8">

                    <Grid WidthRequest="44" HeightRequest="44">
                        <Border BackgroundColor="#B4B3B4" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Notificacoes_Clicked" />
                            </Border.GestureRecognizers>
                            <Label Text="🔔"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <Border x:Name="NotificacaoBadge"
                                IsVisible="False"
                                WidthRequest="19"
                                HeightRequest="19"
                                Padding="0"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                BackgroundColor="#D1242F"
                                Stroke="White"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label x:Name="NotificacaoContagemLabel"
                                   Text="1"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource BrandText}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    
                    <Border WidthRequest="44"
                            HeightRequest="44"
                            BackgroundColor="#B4B3B4"
                            StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Sair_Clicked" />
                        </Border.GestureRecognizers>

                        <Label Text="⏻"
                               FontSize="22"
                               TextColor="{DynamicResource BrandText}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

                    </Border>

                </HorizontalStackLayout>


                <!-- Saudação -->
                <VerticalStackLayout Grid.Row="1"
                                     Grid.ColumnSpan="2"
                                     Spacing="4">

                    <Label x:Name="UsuarioLogadoLabel"
                           Text="Olá, seja bem-vindo! 👋"
                           TextColor="{DynamicResource BrandText}"
                           FontSize="25"
                           FontAttributes="Bold" />

                    <Label Text="Acesse rapidamente as funções do sistema."
                           TextColor="{DynamicResource BrandOnPrimary}"
                           FontSize="14" />

                </VerticalStackLayout>

            </Grid>

        </Border>
        
        <!-- ================================================= -->
        <!-- CONTEÚDO -->
        <!-- ================================================= -->

        <ScrollView Grid.Row="1">

            <VerticalStackLayout Padding="20,22,20,30"
                                 Spacing="20">


                <!-- ================================================= -->
                <!-- RESUMO -->
                <!-- ================================================= -->

                <Grid x:Name="ResumoGrid" ColumnDefinitions="*,*"
                      ColumnSpacing="12">

                    <!-- Clientes -->
                    <Border Grid.Column="0"
                            BackgroundColor="{DynamicResource BrandSurface}"
                            StrokeThickness="0"
                            Padding="16">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="5">

                            <Label Text="CLIENTES"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource BrandMuted}"
                                   CharacterSpacing="1" />

                            <Label x:Name="ClientesResumoLabel"
                                   Text="--"
                                   FontSize="25"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource BrandPrimary}" />

                            <Label Text="Cadastrados"
                                   FontSize="12"
                                   TextColor="{DynamicResource BrandMuted}" />

                        </VerticalStackLayout>

                    </Border>


                    <!-- Vendas -->
                    <Border Grid.Column="1"
                            BackgroundColor="{DynamicResource BrandSurface}"
                            StrokeThickness="0"
                            Padding="16">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="5">

                            <Label Text="VENDAS"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource BrandMuted}"
                                   CharacterSpacing="1" />

                            <Label x:Name="VendasResumoLabel"
                                   Text="R$ --"
                                   FontSize="25"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource BrandPrimary}" />

                            <Label Text="Hoje"
                                   FontSize="12"
                                   TextColor="{DynamicResource BrandMuted}" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- TÍTULO MÓDULOS -->
                <!-- ================================================= -->

                <Grid x:Name="ModulosHeaderGrid" ColumnDefinitions="*,Auto">

                    <Label Grid.Column="0"
                           Text="Módulos"
                           FontSize="21"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource BrandText}" />

                    <Label Grid.Column="1"
                           Text="Todos"
                           FontSize="13"
                           TextColor="{DynamicResource BrandPrimary}"
                           VerticalOptions="Center" />

                </Grid>


                <!-- ================================================= -->
                <!-- MENU -->
                <!-- ================================================= -->

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="14"
                      RowSpacing="14">


                    <!-- COMPRAS -->
                    <Border x:Name="ComprasCard" Grid.Row="2"
                            Grid.Column="0"
                            BackgroundColor="{DynamicResource BrandSurface}"
                            StrokeThickness="0"
                            Padding="16">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Compras_Clicked" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="12">

                            <Border WidthRequest="52"
                                    HeightRequest="52"
                                    BackgroundColor="{DynamicResource BrandSoft}"
                                    StrokeThickness="0"
                                    HorizontalOptions="Start">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Label Text="🛍️"
                                       FontSize="25"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />

                            </Border>

                            <VerticalStackLayout Spacing="3">

                                <Label Text="Compras"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource BrandText}" />

                                <Label Text="Entrada de Mercadorias"
                                       FontSize="12"
                                       TextColor="{DynamicResource BrandMuted}" />

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Border>


                    <!-- VENDAS -->
                    <Border x:Name="VendasCard" Grid.Row="1"
                            Grid.Column="0"
                            BackgroundColor="{DynamicResource BrandSurface}"
                            StrokeThickness="0"
                            Padding="16">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Vendas_Clicked" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="12">

                            <Border WidthRequest="52"
                                    HeightRequest="52"
                                    BackgroundColor="#E8F8F0"
                                    StrokeThickness="0"
                                    HorizontalOptions="Start">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Label Text="🛒"
                                       FontSize="25"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />

                            </Border>

                            <VerticalStackLayout Spacing="3">

                                <Label Text="Vendas"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource BrandText}" />

                                <Label Text="Pedidos"
                                       FontSize="12"
                                       TextColor="{DynamicResource BrandMuted}" />

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Border>
                    
                    <!-- PESSOAS -->
                    <Border x:Name="PessoasCard" Grid.Row="0"
                            Grid.Column="0"
                            BackgroundColor="{DynamicResource BrandSurface}"
                            StrokeThickness="0"
                            Padding="16">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Pessoas_Clicked" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="12">

                            <Border WidthRequest="52"
                                    HeightRequest="52"
                                    BackgroundColor="{DynamicResource BrandSoft}"
                                    StrokeThickness="0"
                                    HorizontalOptions="Start">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Label Text="👥"
                                       FontSize="25"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />

                            </Border>

                            <VerticalStackLayout Spacing="3">

                                <Label Text="Clientes/Fornecedores"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource BrandText}" />

                                <Label Text="Cadastros"
                                       FontSize="12"
                                       TextColor="{DynamicResource BrandMuted}" />

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Border>


                    <!-- PRODUTOS -->
                    <Border x:Name="ProdutosCard" Grid.Row="0"
                            Grid.Column="1"
                            BackgroundColor="{DynamicResource BrandSurface}"
                            StrokeThickness="0"
                            Padding="16">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Produtos_Clicked" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="12">

                            <Border WidthRequest="52"
                                    HeightRequest="52"
                                    BackgroundColor="{DynamicResource BrandSoft}"
                                    StrokeThickness="0"
                                    HorizontalOptions="Start">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Label Text="📦"
                                       FontSize="25"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />

                            </Border>

                            <VerticalStackLayout Spacing="3">

                                <Label Text="Produtos"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource BrandText}" />

                                <Label Text="Estoque"
                                       FontSize="12"
                                       TextColor="{DynamicResource BrandMuted}" />

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                    <!-- FINANCEIRO -->
                    <Border x:Name="FinanceiroCard" Grid.Row="1"
                            Grid.Column="1"
                            BackgroundColor="{DynamicResource BrandSurface}"
                            StrokeThickness="0"
                            Padding="16">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Financeiro_Clicked" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="12">

                            <Border WidthRequest="52"
                                    HeightRequest="52"
                                    BackgroundColor="#FFF4E5"
                                    StrokeThickness="0"
                                    HorizontalOptions="Start">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Label Text="💰"
                                       FontSize="25"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />

                            </Border>

                            <VerticalStackLayout Spacing="3">

                                <Label Text="Financeiro"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource BrandText}" />

                                <Label Text="Contas"
                                       FontSize="12"
                                       TextColor="{DynamicResource BrandMuted}" />

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                    <!-- CONFIGURAÇÕES -->
                    <Border x:Name="ConfiguracoesCard" Grid.Row="2"
                            Grid.Column="1"
                            BackgroundColor="{DynamicResource BrandSurface}"
                            StrokeThickness="0"
                            Padding="16">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Configuracoes_Clicked" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="12">

                            <Border WidthRequest="52"
                                    HeightRequest="52"
                                    BackgroundColor="{DynamicResource BrandSoft}"
                                    StrokeThickness="0"
                                    HorizontalOptions="Start">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Label Text="⚙️"
                                       FontSize="25"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />

                            </Border>

                            <VerticalStackLayout Spacing="3">

                                <Label Text="Configurações"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource BrandText}" />

                                <Label Text="Paleta de cores"
                                       FontSize="12"
                                       TextColor="{DynamicResource BrandMuted}" />

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Border>


                    <!-- USUÁRIOS -->
                    <Border x:Name="AdministracaoCard"
                            Grid.Row="3"
                            Grid.Column="0"
                            BackgroundColor="{DynamicResource BrandSurface}"
                            StrokeThickness="0"
                            Padding="16">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Usuarios_Clicked" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="12">

                            <Border WidthRequest="52"
                                    HeightRequest="52"
                                    BackgroundColor="{DynamicResource BrandSoft}"
                                    StrokeThickness="0"
                                    HorizontalOptions="Start">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Label Text="👥"
                                       FontSize="25"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />

                            </Border>

                            <VerticalStackLayout Spacing="3">

                                <Label x:Name="AdministracaoTituloLabel"
                                       Text="Usuários"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource BrandText}" />

                                <Label x:Name="AdministracaoSubtituloLabel"
                                       Text="Permissões"
                                       FontSize="12"
                                       TextColor="{DynamicResource BrandMuted}" />

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Border>


                    <!-- EMPRESAS: cadastro exclusivo do Administrador Master -->
                    <Border x:Name="EmpresasCard" Grid.Row="4" Grid.Column="1" BackgroundColor="{DynamicResource BrandSurface}" StrokeThickness="0" Padding="16" IsVisible="False">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="Empresas_Clicked" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="12">
                            <Border WidthRequest="52" HeightRequest="52" BackgroundColor="{DynamicResource BrandSoft}" StrokeThickness="0" HorizontalOptions="Start">
                                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                                <Label Text="🏢" FontSize="25" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Empresas" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource BrandText}" />
                                <Label Text="Cadastro e aprovações" FontSize="12" TextColor="{DynamicResource BrandMuted}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- CHAT -->
                    <Border x:Name="ConversasCard" Grid.Row="4" Grid.Column="0" BackgroundColor="{DynamicResource BrandSurface}" StrokeThickness="0" Padding="16">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="Chat_Clicked" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="12">
                            <Border WidthRequest="52" HeightRequest="52" BackgroundColor="{DynamicResource BrandSoft}" StrokeThickness="0" HorizontalOptions="Start">
                                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                                <Label Text="💬" FontSize="25" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Chat" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource BrandText}" />
                                <Label Text="Mensagens e fotos" FontSize="12" TextColor="{DynamicResource BrandMuted}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- OUTROS -->
                    <Border x:Name="OutrosCard" Grid.Row="3"
                            Grid.Column="1"
                            BackgroundColor="{DynamicResource BrandSurface}"
                            StrokeThickness="0"
                            Padding="16">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Outros_Clicked" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="12">

                            <Border WidthRequest="52"
                                    HeightRequest="52"
                                    BackgroundColor="{DynamicResource BrandSoft}"
                                    StrokeThickness="0"
                                    HorizontalOptions="Start">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Label Text="＋"
                                       FontSize="30"
                                       TextColor="{DynamicResource BrandPrimary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />

                            </Border>

                            <VerticalStackLayout Spacing="3">

                                <Label Text="Outros"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource BrandText}" />

                                <Label Text="Mais funções"
                                       FontSize="12"
                                       TextColor="{DynamicResource BrandMuted}" />

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </Grid>


                <!-- RODAPÉ -->
                <Label Text="CATCHAT • Sistema de gestão"
                       FontSize="11"
                       TextColor="{DynamicResource BrandMuted}"
                       HorizontalOptions="Center"
                       Margin="0,5,0,0" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>

