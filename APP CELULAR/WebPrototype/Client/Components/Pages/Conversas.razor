@page "/conversas"
@page "/conversas/{ContatoId:long}"
@implements IAsyncDisposable
@using WebPrototype.Services
@using Microsoft.JSInterop
@inject ChatPortalState Portal
@inject ChatRealtimeClient Realtime
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Conversas · CATCHAT</PageTitle>

@if (!Portal.Autenticado)
{
    <div class="page-loading">Abrindo acesso…</div>
}
else
{
    <div class="messaging-shell">
        <header class="messaging-topbar">
            <a class="wordmark chatcat-wordmark" href="/main"><img src="catchat_official.png" alt="" /> CATCHAT</a>
            <div class="messaging-account"><span class="avatar">@Portal.Sessao!.Usuario[..1].ToUpperInvariant()</span><span>@Portal.Sessao.Usuario · Empresa @Portal.Sessao.EmpresaId</span><button class="logout-button" @onclick="SairAsync">Sair <span aria-hidden="true">↗</span></button></div>
        </header>

        @if (!string.IsNullOrWhiteSpace(erro))
        {
            <div class="chat-notice" role="alert">@erro <button aria-label="Fechar aviso" @onclick="() => erro = null">×</button></div>
        }

        <div class="messaging-layout">
            <aside class="conversation-sidebar @(ContatoId.HasValue ? "sidebar-on-chat" : "")">
                <div class="sidebar-title"><div><p class="eyebrow">CATCHAT</p><h1>Conversas</h1></div><span class="contact-count">@contatos.Count</span><button class="secondary-button" type="button" @onclick="() => CarregarContatosAsync(exibirErro: true)" disabled="@carregandoContatos">Atualizar</button></div>
                <label class="contact-search"><span aria-hidden="true">⌕</span><input @bind="filtroContato" @bind:event="oninput" placeholder="Buscar pessoa..." aria-label="Buscar pessoa" /></label>
                <div class="contact-list">
                    @if (carregandoContatos && contatos.Count == 0)
                    {
                        <p class="chat-loading">Carregando contatos…</p>
                    }
                    else if (!ContatosFiltrados.Any())
                    {
                        <div class="contact-empty">@(string.IsNullOrWhiteSpace(filtroContato) ? $"Nenhum outro usuário ativo encontrado na empresa {Portal.Sessao!.EmpresaId}. Peça ao Zeus para conferir se os usuários estão aprovados, ativos e vinculados a essa mesma empresa; depois atualize." : "Nenhuma pessoa encontrada.")</div>
                    }
                    else
                    {
                        @foreach (var contato in ContatosFiltrados)
                        {
                            <a class="contact-item @(ContatoId == contato.Id ? "contact-active" : "")" href="@($"/conversas/{contato.Id}")">
                                <span class="contact-avatar">@PrimeiraLetra(contato.Nome)</span>
                                <span class="contact-copy"><strong>@contato.Nome</strong><small>@(string.IsNullOrWhiteSpace(contato.UltimaMensagem) ? "Iniciar conversa" : contato.UltimaMensagem)</small></span>
                                <span class="contact-meta">@if (contato.NaoLidas > 0) { <b>@contato.NaoLidas</b> }</span>
                            </a>
                        }
                    }
                </div>
                <p class="chat-sync-note">Contatos ativos da empresa · atualize após uma liberação</p>
            </aside>

            <main class="conversation-panel @(ContatoId.HasValue ? "chat-on-mobile" : "")">
                @if (ContatoAtual is null)
                {
                    <div class="conversation-welcome"><span class="welcome-icon">✉</span><h2>Suas conversas</h2><p>Escolha uma pessoa para abrir o chat. As mensagens usam sua conta do APP CELULAR.</p></div>
                }
                else
                {
                    <header class="active-contact">
                        <a class="mobile-back" href="/conversas" aria-label="Voltar às conversas">‹</a>
                        <span class="contact-avatar large">@PrimeiraLetra(ContatoAtual.Nome)</span>
                        <div><strong>@ContatoAtual.Nome</strong><small>Conversa sincronizada</small></div>
                    </header>

                    <section class="messages-body" aria-label="Mensagens da conversa" @ref="painelMensagens">
                        @if (!string.IsNullOrWhiteSpace(acaoVisual))
                        {
                            <div class="visual-action-toast" role="status">@acaoVisual</div>
                        }
                        @if (carregandoMensagens && mensagens.Count == 0)
                        {
                            <p class="chat-loading">Carregando mensagens…</p>
                        }
                        else if (mensagens.Count == 0)
                        {
                            <div class="conversation-welcome compact"><span class="welcome-icon">✉</span><h2>Comece a conversa</h2><p>Envie uma mensagem para @ContatoAtual.Nome.</p></div>
                        }
                        else
                        {
                            @foreach (var mensagem in mensagens)
                            {
                                var minha = mensagem.RemetenteId == Portal.Sessao!.UsuarioId;
                                <div class="message-row @(minha ? "message-own" : "message-incoming")">
                                    <article class="message-bubble">
                                        @if (!string.IsNullOrWhiteSpace(mensagem.FotoUrl) && (mensagem.MidiaTipo ?? mensagem.FotoTipo ?? "").StartsWith("video/", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <video class="message-image" src="@mensagem.FotoUrl" controls playsinline preload="metadata"></video>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(mensagem.FotoUrl))
                                        {
                                            <img class="message-image" src="@mensagem.FotoUrl" alt="Imagem enviada na conversa" />
                                        }
                                        else if (mensagem.Foto is { Length: > 0 } foto && !string.IsNullOrWhiteSpace(mensagem.FotoTipo) && mensagem.FotoTipo.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <img class="message-image" src="@($"data:{mensagem.FotoTipo};base64,{Convert.ToBase64String(foto)}")" alt="Imagem enviada na conversa" />
                                        }
                                        else if (!string.IsNullOrWhiteSpace(mensagem.MidiaChave))
                                        {
                                            <button type="button" class="message-media-load" @onclick="() => CarregarMidiaAsync(mensagem)">Carregar mídia</button>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(mensagem.Texto))
                                        {
                                            <p class="@(EhFigurinha(mensagem.Texto) ? "message-sticker" : null)" style="font-size:@(tamanhoFonte)px;font-weight:@(fonteSemibold ? 600 : 400)">@mensagem.Texto</p>
                                        }
                                        <footer><time>@HoraBrasilia(mensagem.EnviadaEm)</time>@if (minha) { <span>@(mensagem.StatusEnvio ?? (mensagem.LidaEm.HasValue ? "✓✓" : "✓"))</span> }</footer>
                                    </article>
                                </div>
                            }
                        }
                    </section>

                    @if (!Portal.EhZeus)
                    {
                    <form class="message-composer" @onsubmit="EnviarAsync" @onsubmit:preventDefault="true">
                        <div class="chatcat-actions" aria-label="Ações da conversa">
                            <label class="chatcat-action" for="foto-conversa" title="Foto" aria-label="Foto"><span>＋</span></label>
                            <InputFile id="foto-conversa" class="chatcat-file-input" accept="image/*,video/*" OnChange="SelecionarFotoAsync" disabled="@enviando" />
                            <button type="button" title="Abrir figurinhas" aria-label="Abrir figurinhas" disabled="@enviando" @onclick="AlternarFigurinhas">▧</button>
                            <button type="button" title="Fonte" aria-label="Fonte" disabled="@enviando" @onclick="AlternarFonte">Aa</button>
                            <button type="button" class="attention-action" data-chatcat-attention title="Chamar atenção do contato" aria-label="Chamar atenção do contato" disabled="@enviando" @onclick='() => EnviarAcaoVisualAsync("ATTENTION", "⚡")'>⚡</button>
                            <button type="button" title="Abrir mais ações" aria-label="Abrir mais ações" disabled="@enviando" @onclick="AlternarMaisAcoes">⋯</button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(fotoChave))
                        {
                            <div class="selected-photo-preview">
                                @if ((fotoTipo ?? "").StartsWith("video/", StringComparison.OrdinalIgnoreCase))
                                {
                                    <video src="@fotoPreview" controls playsinline></video>
                                }
                                else
                                {
                                    <img src="@fotoPreview" alt="Foto selecionada para envio" />
                                }
                                <span>@fotoNome</span>
                                <button type="button" title="Remover foto" aria-label="Remover foto" @onclick="RemoverFoto">×</button>
                            </div>
                        }
                        @if (mostrarFigurinhas)
                        {
                            <div class="chatcat-stickers" aria-label="Figurinhas">
                                <strong>Figurinhas</strong>
                                <button type="button" title="Gato" disabled="@enviando" @onclick='() => EnviarFigurinhaAsync("😺")'>😺</button>
                                <button type="button" title="Riso" disabled="@enviando" @onclick='() => EnviarFigurinhaAsync("😂")'>😂</button>
                                <button type="button" title="Coração" disabled="@enviando" @onclick='() => EnviarFigurinhaAsync("❤️")'>❤️</button>
                                <button type="button" title="Fogo" disabled="@enviando" @onclick='() => EnviarFigurinhaAsync("🔥")'>🔥</button>
                            </div>
                        }
                        @if (mostrarMaisAcoes)
                        {
                            <div class="chatcat-stickers chatcat-winks" aria-label="Mais ações da conversa">
                                <strong>Mais ações da conversa</strong>
                                @foreach (var wink in winks)
                                {
                                    <button type="button" title="Enviar wink @wink" aria-label="Enviar wink @wink" disabled="@enviando" @onclick='() => EnviarAcaoVisualAsync("WINK", wink)'>@wink</button>
                                }
                            </div>
                        }
                        <textarea @bind="texto" @bind:event="oninput" placeholder="Mensagem" aria-label="Mensagem" rows="1" maxlength="4000" disabled="@enviando"></textarea>
                        <button class="primary-button" type="submit" disabled="@(!PodeEnviar)">@(enviando ? "Enviando…" : "Enviar")</button>
                    </form>
                    }
                    else
                    {
                        <p class="muted" role="status">Zeus master está em modo de leitura global.</p>
                    }
                }
            </main>
        </div>
    </div>
}

@code {
    [Parameter] public long? ContatoId { get; set; }

    private readonly CancellationTokenSource polling = new();
    private readonly List<ContatoConversa> contatos = new();
    private readonly List<MensagemConversa> mensagens = new();
    private string filtroContato = "";
    private string texto = "";
    private string? erro;
    private string? acaoVisual;
    private long? contatoCarregado;
    private bool carregandoContatos;
    private bool carregandoMensagens;
    private bool enviando;
    private bool inicializado;
    private bool rolarMensagens;
    private ElementReference painelMensagens;
    private long idMensagemLocal;
    private const int TamanhoMaximoFoto = 8 * 1024 * 1024;
    private const long TamanhoMaximoVideo = 100 * 1024 * 1024;
    private static readonly string[] winks = ["✨", "💥", "🎉", "😺", "💫", "🚀"];
    private string? fotoChave;
    private string? fotoNome;
    private string? fotoTipo;
    private long fotoTamanho;
    private Guid idMensagemMidia;
    private string? fotoPreview;
    private bool mostrarFigurinhas;
    private bool mostrarMaisAcoes;
    private int tamanhoFonte = 13;
    private bool fonteSemibold;
    private DateTimeOffset proximaTentativaRealtime;
    private int ciclosPolling;
    private static readonly TimeZoneInfo FusoBrasilia = ObterFusoBrasilia();

    private IEnumerable<ContatoConversa> ContatosFiltrados => contatos
        .Where(contato => contato.Nome.Contains(filtroContato.Trim(), StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(contato => contato.DataUltimaMensagem.HasValue)
        .ThenByDescending(contato => contato.DataUltimaMensagem)
        .ThenBy(contato => contato.Nome);

    private ContatoConversa? ContatoAtual => ContatoId is null ? null : contatos.FirstOrDefault(contato => contato.Id == ContatoId.Value);
    private bool PodeEnviar => !enviando && ContatoAtual is not null && (!string.IsNullOrWhiteSpace(texto) || !string.IsNullOrWhiteSpace(fotoChave));

    private static string HoraBrasilia(DateTime data)
    {
        var utc = data.Kind switch
        {
            DateTimeKind.Utc => data,
            DateTimeKind.Local => data.ToUniversalTime(),
            _ => DateTime.SpecifyKind(data, DateTimeKind.Utc)
        };
        return TimeZoneInfo.ConvertTimeFromUtc(utc, FusoBrasilia).ToString("HH:mm");
    }

    private static TimeZoneInfo ObterFusoBrasilia()
    {
        try { return TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo"); }
        catch (TimeZoneNotFoundException) { return TimeZoneInfo.FindSystemTimeZoneById("E. South America Standard Time"); }
    }

    private async Task SelecionarFotoAsync(InputFileChangeEventArgs args)
    {
        mostrarFigurinhas = false;
        mostrarMaisAcoes = false;
        var arquivo = args.File;
        var tipo = arquivo.ContentType ?? "";
        if (!(tipo.StartsWith("image/", StringComparison.OrdinalIgnoreCase) || tipo.StartsWith("video/", StringComparison.OrdinalIgnoreCase)))
        {
            erro = "Escolha uma foto ou vídeo compatível.";
            return;
        }
        var limite = tipo.StartsWith("video/", StringComparison.OrdinalIgnoreCase) ? TamanhoMaximoVideo : TamanhoMaximoFoto;
        if (arquivo.Size <= 0 || arquivo.Size > limite)
        {
            erro = tipo.StartsWith("video/", StringComparison.OrdinalIgnoreCase) ? "O vídeo deve ter no máximo 100 MB." : "A foto deve ter no máximo 8 MB.";
            return;
        }

        try
        {
            idMensagemMidia = Guid.NewGuid();
            fotoChave = $"pendente:{idMensagemMidia:N}";
            fotoPreview = await JS.InvokeAsync<string>("appCelular.previewInputFile", "foto-conversa");
            fotoNome = arquivo.Name;
            fotoTipo = tipo;
            fotoTamanho = arquivo.Size;
            await JS.InvokeVoidAsync("appCelular.cacheInputFile", "foto-conversa", fotoChave);
            erro = null;
        }
        catch (Exception ex)
        {
            erro = $"Não foi possível preparar a mídia: {ex.Message}";
        }
    }

    private void RemoverFoto()
    {
        fotoChave = null;
        fotoNome = null;
        fotoTipo = null;
        fotoTamanho = 0;
        idMensagemMidia = Guid.Empty;
        fotoPreview = null;
    }

    private void AlternarFigurinhas()
    {
        mostrarFigurinhas = !mostrarFigurinhas;
        mostrarMaisAcoes = false;
    }

    private void AlternarMaisAcoes()
    {
        mostrarMaisAcoes = !mostrarMaisAcoes;
        mostrarFigurinhas = false;
    }

    private void AlternarFonte()
    {
        tamanhoFonte = tamanhoFonte == 13 ? 15 : tamanhoFonte == 15 ? 18 : tamanhoFonte == 18 ? 22 : 13;
        fonteSemibold = !fonteSemibold;
    }

    protected override void OnInitialized()
    {
        if (!Portal.Autenticado)
            Navigation.NavigateTo("/login", replace: true);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!inicializado || ContatoId == contatoCarregado)
            return;

        contatoCarregado = ContatoId;
        mensagens.Clear();
        if (ContatoId.HasValue && ContatoAtual is not null)
        {
            try
            {
                var locais = await JS.InvokeAsync<List<MensagemConversa>>("appCelular.getChatMessages", ChaveCacheConversa(ContatoId.Value));
                if (locais.Count > 0)
                {
                    mensagens.AddRange(locais.OrderBy(m => m.EnviadaEm).ThenBy(m => m.Id));
                    await PrepararMidiasAsync(mensagens);
                    rolarMensagens = true;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (JSException)
            {
                // Se o armazenamento local não estiver disponível, a conversa continua usando a API.
            }
            await CarregarMensagensAsync(exibirErro: true, marcarComoLidas: true);
            rolarMensagens = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Portal.Autenticado)
        {
            inicializado = true;
            await CarregarContatosAsync(exibirErro: true);
            Realtime.MensagemRecebida += AoReceberMensagemAsync;
            Realtime.Reconectado += AoReconectarAsync;
            try { await Realtime.ConectarAsync(Portal.Sessao!); }
            catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"Supabase Realtime indisponível; será usada sincronização incremental: {ex.Message}"); }
            await OnParametersSetAsync();
            _ = AcompanharConversasAsync(polling.Token);
            StateHasChanged();
        }

        if (!rolarMensagens)
            return;

        rolarMensagens = false;
        try { await JS.InvokeVoidAsync("appCelular.scrollMessagesToBottom", painelMensagens); }
        catch (JSException) { }
    }

    private async Task CarregarContatosAsync(bool exibirErro)
    {
        if (carregandoContatos || !Portal.Autenticado)
            return;

        carregandoContatos = true;
        try
        {
            var atualizados = await Portal.ObterContatosAsync();
            contatos.Clear();
            contatos.AddRange(atualizados);
            erro = null;
        }
        catch (InvalidOperationException ex)
        {
            if (exibirErro) erro = ex.Message;
        }
        finally
        {
            carregandoContatos = false;
        }
    }

    private async Task CarregarMensagensAsync(bool exibirErro, bool marcarComoLidas, bool buscarAcoes = true)
    {
        if (carregandoMensagens || !ContatoId.HasValue || !Portal.Autenticado)
            return;

        carregandoMensagens = true;
        try
        {
            var cursor = mensagens.Where(m => m.Id > 0).Select(m => m.Id).DefaultIfEmpty(0).Max();
            var recebidas = await Portal.ObterMensagensAsync(ContatoId.Value, cursor);
            await PrepararMidiasAsync(recebidas);
            bool novaRecebida = recebidas.Any(m => m.RemetenteId != Portal.Sessao!.UsuarioId &&
                !mensagens.Any(atual => atual.Id == m.Id ||
                    (m.ClienteMensagemId != Guid.Empty && atual.ClienteMensagemId == m.ClienteMensagemId)));
            bool mudou = recebidas.Count > 0;
            foreach (var recebida in recebidas)
            {
                var indice = mensagens.FindIndex(atual =>
                    (recebida.Id > 0 && atual.Id == recebida.Id) ||
                    (recebida.ClienteMensagemId != Guid.Empty && atual.ClienteMensagemId == recebida.ClienteMensagemId));
                if (indice >= 0)
                    mensagens[indice] = recebida;
                else
                    mensagens.Add(recebida);
            }
            if (recebidas.Count > 0)
            {
                try { await JS.InvokeVoidAsync("appCelular.saveChatMessages", ChaveCacheConversa(ContatoId.Value), recebidas); }
                catch (JSException) { /* A conversa segue ativa mesmo se o navegador bloquear o cache. */ }
            }
            var pendentes = mensagens.Where(m => m.StatusEnvio == "Enviando…" || m.StatusEnvio == "Falha no envio").ToList();
            foreach (var pendente in pendentes)
            {
                bool chegouDaApi = recebidas.Any(m => m.Id == pendente.Id ||
                    (pendente.ClienteMensagemId != Guid.Empty && m.ClienteMensagemId == pendente.ClienteMensagemId));
                if (chegouDaApi && pendente.StatusEnvio == "Enviando…")
                {
                    pendente.StatusEnvio = null;
                    mudou = true;
                }
            }
            var ordenadas = mensagens.OrderBy(m => m.EnviadaEm).ThenBy(m => m.Id).ToList();
            if (mudou)
            {
                mensagens.Clear();
                mensagens.AddRange(ordenadas);
                rolarMensagens = true;
            }

            if (marcarComoLidas && (ContatoAtual?.NaoLidas > 0 || novaRecebida))
            {
                await Portal.MarcarComoLidasAsync(ContatoId.Value);
                if (ContatoAtual is { } contatoLido)
                    contatoLido.NaoLidas = 0;
            }
            if (buscarAcoes)
                await CarregarAcoesVisuaisAsync();
            erro = null;
        }
        catch (InvalidOperationException ex)
        {
            if (exibirErro) erro = ex.Message;
        }
        finally
        {
            carregandoMensagens = false;
        }
    }

    private async Task CarregarAcoesVisuaisAsync()
    {
        if (!ContatoId.HasValue || !Portal.Autenticado)
            return;

        var acoes = await Portal.ObterAcoesVisuaisAsync(ContatoId.Value);
        if (acoes.Count == 0)
            return;

        var acao = acoes[^1];
        acaoVisual = acao.Tipo == "ATTENTION"
            ? $"⚡ {acao.Simbolo} chamou sua atenção"
            : $"{acao.Simbolo} recebeu um wink";
        _ = LimparAcaoVisualAsync(acaoVisual);
    }

    private Task AoReconectarAsync() => InvokeAsync(async () =>
    {
        if (ContatoId.HasValue && Portal.Autenticado)
            await CarregarMensagensAsync(exibirErro: false, marcarComoLidas: true, buscarAcoes: false);
        StateHasChanged();
    });

    private Task AoReceberMensagemAsync(MensagemConversa mensagem) => InvokeAsync(async () =>
    {
        if (!Portal.Autenticado || Portal.Sessao is not { } sessao)
            return;

        var contatoId = mensagem.RemetenteId == sessao.UsuarioId
            ? mensagem.DestinatarioId
            : mensagem.RemetenteId;
        var contato = contatos.FirstOrDefault(item => item.Id == contatoId);
        if (contato is null)
            return;

        contato.UltimaMensagem = string.IsNullOrWhiteSpace(mensagem.Texto) ? "[Mídia]" : mensagem.Texto;
        contato.DataUltimaMensagem = mensagem.EnviadaEm;
        var minha = mensagem.RemetenteId == sessao.UsuarioId;
        var conversaAberta = ContatoId == contatoId;
        if (!minha && !conversaAberta)
            contato.NaoLidas++;

        if (conversaAberta)
        {
            var indice = mensagens.FindIndex(atual =>
                (mensagem.Id > 0 && atual.Id == mensagem.Id) ||
                (mensagem.ClienteMensagemId != Guid.Empty && atual.ClienteMensagemId == mensagem.ClienteMensagemId));
            if (indice >= 0)
            {
                mensagens[indice] = mensagem;
                mensagem.StatusEnvio = null;
            }
            else
            {
                mensagens.Add(mensagem);
            }

            await PrepararMidiasAsync([mensagem]);
            mensagens.Sort((a, b) => a.EnviadaEm != b.EnviadaEm
                ? a.EnviadaEm.CompareTo(b.EnviadaEm)
                : a.Id.CompareTo(b.Id));
            try { await JS.InvokeVoidAsync("appCelular.saveChatMessages", ChaveCacheConversa(contatoId), new[] { mensagem }); }
            catch (JSException) { }
            rolarMensagens = true;

            if (!minha)
            {
                await Portal.MarcarComoLidasAsync(contatoId);
                contato.NaoLidas = 0;
            }
        }

        StateHasChanged();
    });

    private async Task PrepararMidiasAsync(IEnumerable<MensagemConversa> itens)
    {
        foreach (var mensagem in itens.Where(m => !string.IsNullOrWhiteSpace(m.MidiaChave) && string.IsNullOrWhiteSpace(m.FotoUrl)))
        {
            try
            {
                var urlLocal = await JS.InvokeAsync<string?>("appCelular.loadChatMedia", ChaveCacheConversa(ContatoId!.Value), mensagem.MidiaChave, null);
                if (string.IsNullOrWhiteSpace(urlLocal) && mensagem.Id > 0)
                {
                    var link = await Portal.CriarUrlLeituraAsync(mensagem.MidiaChave!);
                    urlLocal = await JS.InvokeAsync<string?>("appCelular.loadChatMedia", ChaveCacheConversa(ContatoId.Value), mensagem.MidiaChave, link.Url);
                }
                mensagem.FotoUrl = urlLocal;
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Mídia {mensagem.Id} ficará disponível ao tocar para carregar: {ex.Message}");
            }
        }
    }

    private async Task CarregarMidiaAsync(MensagemConversa mensagem)
    {
        if (ContatoId is null || string.IsNullOrWhiteSpace(mensagem.MidiaChave)) return;
        try
        {
            var link = await Portal.CriarUrlLeituraAsync(mensagem.MidiaChave);
            mensagem.FotoUrl = await JS.InvokeAsync<string>("appCelular.loadChatMedia", ChaveCacheConversa(ContatoId.Value), mensagem.MidiaChave, link.Url);
        }
        catch (Exception ex)
        {
            erro = $"Não foi possível abrir a mídia: {ex.Message}";
        }
    }

    private async Task AcompanharConversasAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(20));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (!Portal.Autenticado)
                    return;
                ciclosPolling++;
                bool buscarAcoes = ciclosPolling % 3 == 0;

                await InvokeAsync(async () =>
                {
                    if (!Realtime.Conectado && DateTimeOffset.UtcNow >= proximaTentativaRealtime)
                    {
                        proximaTentativaRealtime = DateTimeOffset.UtcNow.AddSeconds(30);
                        try { await Realtime.ConectarAsync(Portal.Sessao!); }
                        catch (Exception ex) { System.Diagnostics.Debug.WriteLine($"SignalR ainda indisponível: {ex.Message}"); }
                    }

                    if (ContatoId.HasValue)
                    {
                        await CarregarMensagensAsync(exibirErro: false, marcarComoLidas: true, buscarAcoes: buscarAcoes);
                    }
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // A navegação encerra a atualização periódica ao fechar a página.
        }
        catch (ObjectDisposedException)
        {
            // O circuito foi encerrado.
        }
    }

    private async Task EnviarAsync()
    {
        if (!PodeEnviar || !ContatoId.HasValue)
            return;

        mostrarFigurinhas = false;
        mostrarMaisAcoes = false;
        var textoEnviado = texto.Trim();
        var chaveFotoEnviada = fotoChave;
        var nomeFotoEnviada = fotoNome;
        var tipoFotoEnviada = fotoTipo;
        var tamanhoFotoEnviada = fotoTamanho;
        var previewFotoEnviada = fotoPreview;
        var idCliente = idMensagemMidia != Guid.Empty ? idMensagemMidia : Guid.NewGuid();
        var mensagemLocal = new MensagemConversa
        {
            Id = --idMensagemLocal,
            ClienteMensagemId = idCliente,
            RemetenteId = Portal.Sessao!.UsuarioId,
            RemetenteNome = Portal.Sessao.Usuario,
            DestinatarioId = ContatoId.Value,
            Texto = textoEnviado,
            MidiaChave = chaveFotoEnviada,
            MidiaNome = nomeFotoEnviada,
            MidiaTipo = tipoFotoEnviada,
            MidiaTamanhoBytes = tamanhoFotoEnviada,
            FotoUrl = previewFotoEnviada,
            FotoNome = nomeFotoEnviada,
            FotoTipo = tipoFotoEnviada,
            EnviadaEm = DateTime.UtcNow,
            StatusEnvio = "Enviando…"
        };
        mensagens.Add(mensagemLocal);
        try { await JS.InvokeVoidAsync("appCelular.saveChatMessages", ChaveCacheConversa(ContatoId.Value), new[] { mensagemLocal }); }
        catch (JSException) { }
        texto = "";
        RemoverFoto();
        enviando = true;
        rolarMensagens = true;
        erro = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            if (!string.IsNullOrWhiteSpace(chaveFotoEnviada) && chaveFotoEnviada.StartsWith("pendente:", StringComparison.Ordinal))
            {
                chaveFotoEnviada = await Portal.UploadMidiaAsync(ContatoId.Value, idCliente, "foto-conversa", nomeFotoEnviada ?? "midia", tipoFotoEnviada ?? "application/octet-stream");
                mensagemLocal.MidiaChave = chaveFotoEnviada;
                await JS.InvokeVoidAsync("appCelular.cacheInputFile", "foto-conversa", chaveFotoEnviada);
            }
            var enviada = await Portal.EnviarMensagemAsync(ContatoId.Value, textoEnviado, idCliente, chaveFotoEnviada, nomeFotoEnviada, tipoFotoEnviada, tamanhoFotoEnviada > 0 ? tamanhoFotoEnviada : null);
            enviada.FotoUrl = previewFotoEnviada;
            enviada.StatusEnvio = null;
            var indiceLocal = mensagens.IndexOf(mensagemLocal);
            if (indiceLocal >= 0)
                mensagens[indiceLocal] = enviada;
            try { await JS.InvokeVoidAsync("appCelular.saveChatMessages", ChaveCacheConversa(ContatoId.Value), new[] { enviada }); }
            catch (JSException) { }
            rolarMensagens = true;
        }
        catch (InvalidOperationException ex)
        {
            mensagemLocal.StatusEnvio = "Falha no envio";
            try { await JS.InvokeVoidAsync("appCelular.saveChatMessages", ChaveCacheConversa(ContatoId.Value), new[] { mensagemLocal }); }
            catch (JSException) { }
            texto = textoEnviado;
            fotoChave = chaveFotoEnviada;
            fotoNome = nomeFotoEnviada;
            fotoTipo = tipoFotoEnviada;
            fotoTamanho = tamanhoFotoEnviada;
            fotoPreview = previewFotoEnviada;
            idMensagemMidia = idCliente;
            erro = ex.Message;
        }
        finally
        {
            enviando = false;
        }
    }

    private async Task EnviarAcaoVisualAsync(string tipo, string simbolo)
    {
        if (enviando || ContatoAtual is null)
            return;

        mostrarFigurinhas = false;
        mostrarMaisAcoes = false;
        var contatoNome = ContatoAtual.Nome;
        if (tipo == "ATTENTION")
        {
            acaoVisual = $"⚡ Você chamou {contatoNome}";
            _ = LimparAcaoVisualAsync(acaoVisual);
        }
        enviando = true;
        erro = null;
        try
        {
            await Portal.EnviarAcaoVisualAsync(ContatoAtual.Id, tipo, simbolo);
            if (tipo != "ATTENTION")
            {
                acaoVisual = $"{simbolo} Wink enviado";
                _ = LimparAcaoVisualAsync(acaoVisual);
            }
        }
        catch (InvalidOperationException ex)
        {
            erro = ex.Message;
        }
        finally
        {
            enviando = false;
        }
    }

    private async Task EnviarFigurinhaAsync(string emoji)
    {
        if (enviando || ContatoAtual is null)
            return;
        mostrarFigurinhas = false;
        mostrarMaisAcoes = false;
        texto = emoji;
        await EnviarAsync();
    }

    private async Task LimparAcaoVisualAsync(string? exibida)
    {
        await Task.Delay(TimeSpan.FromSeconds(2.5));
        await InvokeAsync(() =>
        {
            if (acaoVisual == exibida)
                acaoVisual = null;
            StateHasChanged();
        });
    }

    private async Task SairAsync()
    {
        try { await JS.InvokeVoidAsync("appCelular.clearSavedSession"); }
        catch (JSException) { }
        try
        {
            await Portal.SairAsync();
        }
        catch (InvalidOperationException)
        {
            // A sessão local deve ser encerrada mesmo se a API estiver indisponível.
        }
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private static string PrimeiraLetra(string nome) =>
        string.IsNullOrWhiteSpace(nome) ? "?" : nome.Trim()[..1].ToUpperInvariant();

    private string ChaveCacheConversa(long contatoId) =>
        $"{Portal.Sessao!.EmpresaId}:{Portal.Sessao.UsuarioId}:{contatoId}";

    private static bool EhFigurinha(string texto) =>
        new[] { "😺", "😂", "😍", "🙌", "👍", "❤️", "🎉", "🔥" }.Contains(texto.Trim(), StringComparer.Ordinal);

    public ValueTask DisposeAsync()
    {
        polling.Cancel();
        polling.Dispose();
        Realtime.MensagemRecebida -= AoReceberMensagemAsync;
        Realtime.Reconectado -= AoReconectarAsync;
        return Realtime.DisposeAsync();
    }
}
