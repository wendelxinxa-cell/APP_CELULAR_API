@page "/"
@page "/login"
@page "/redefinir-senha"
@using System.Globalization
@using Microsoft.JSInterop
@using WebPrototype.Services
@inject ChatPortalState Portal
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Entrar · CATCHAT</PageTitle>

<main class="login-page">
    <section class="login-card">
        <div class="brand-mark" aria-label="CATCHAT"><img src="/app-icon.svg" alt="" /></div>
        <p class="eyebrow">CATCHAT</p>
        @if (modoConfirmarEmail)
        {
            <h1>@(emailCadastroConfirmado ? "E-mail confirmado" : "Confirmando seu e-mail")</h1>
            @if (emailCadastroConfirmado)
            {
                <p class="muted login-intro">Pronto. Seu pedido foi encaminhado para Pendências. Zeus poderá liberar seu acesso; se aprovado, você receberá outro e-mail para criar sua senha.</p>
                <a class="primary-button login-submit" href="/login">Voltar ao login</a>
            }
            else if (!string.IsNullOrWhiteSpace(erro))
            {
                <div class="notice error" role="alert">@erro</div>
                <a class="primary-button login-submit" href="/solicitar-acesso">Solicitar novo link</a>
            }
            else
            {
                <p class="muted login-intro">Estamos confirmando seu endereço de e-mail…</p>
            }
        }
        else if (senhaAtualizada)
        {
            <h1>Senha atualizada</h1>
            <p class="muted login-intro">Sua senha foi redefinida. Entre novamente com a nova senha.</p>
            <a class="primary-button login-submit" href="/login">Voltar ao login <span aria-hidden="true">→</span></a>
        }
        else if (modoRecuperacao)
        {
            <h1>Crie uma nova senha</h1>
            <p class="muted login-intro">Escolha uma senha para sua conta CATCHAT.</p>
            <EditForm Model="novaSenhaForm" OnValidSubmit="SalvarNovaSenhaAsync">
                <div class="field">
                    <label for="new-password">Nova senha</label>
                    <input id="new-password" type="password" @bind="novaSenhaForm.Senha" autocomplete="new-password" minlength="8" required />
                </div>
                <div class="field">
                    <label for="confirm-password">Confirme a nova senha</label>
                    <input id="confirm-password" type="password" @bind="novaSenhaForm.Confirmacao" autocomplete="new-password" minlength="8" required />
                </div>
                @if (!string.IsNullOrWhiteSpace(erro))
                {
                    <div class="notice error" role="alert">@erro</div>
                }
                <button class="primary-button login-submit" type="submit" disabled="@salvandoSenha">
                    @(salvandoSenha ? "Salvando…" : "Salvar nova senha") <span aria-hidden="true">→</span>
                </button>
            </EditForm>
        }
        else if (modoSolicitarRecuperacao)
        {
            <h1>Recuperar senha</h1>
            <p class="muted login-intro">Informe o e-mail da conta. Enviaremos um link para criar uma nova senha.</p>
            <EditForm Model="form" OnValidSubmit="SolicitarRecuperacaoAsync">
                <div class="field">
                    <label for="recovery-email">E-mail da conta Supabase</label>
                    <input id="recovery-email" type="email" @bind="form.Email" autocomplete="email" placeholder="voce@exemplo.com" required />
                </div>
                @if (!string.IsNullOrWhiteSpace(erro))
                {
                    <div class="notice error" role="alert">@erro</div>
                }
                @if (!string.IsNullOrWhiteSpace(mensagemRecuperacao))
                {
                    <div class="notice success" role="status">@mensagemRecuperacao</div>
                }
                <button class="primary-button login-submit" type="submit" disabled="@solicitandoRecuperacao">
                    @(solicitandoRecuperacao ? "Enviando…" : "Enviar link") <span aria-hidden="true">→</span>
                </button>
            </EditForm>
            <p class="login-register"><button class="text-button" type="button" @onclick="VoltarAoLogin">Voltar ao login</button></p>
        }
        else
        {
        <h1>Acesso ao sistema</h1>
        <p class="muted login-intro">Entre com sua conta do aplicativo para acessar suas conversas.</p>

        <EditForm Model="form" OnValidSubmit="EntrarAsync">
            <div class="field">
                <label for="username">E-mail ou apelido</label>
                <input id="username" type="text" @bind="form.Email" autocomplete="username" placeholder="E-mail ou apelido cadastrado" />
            </div>
            <div class="field">
                <label for="password">Senha</label>
                <div class="password-field">
                    <input id="password" type="@(mostrarSenha ? "text" : "password")" @bind="form.Senha" autocomplete="current-password" placeholder="Digite sua senha" />
                    <button class="reveal-button" type="button" @onclick="() => mostrarSenha = !mostrarSenha" aria-label="Mostrar ou ocultar senha">@(mostrarSenha ? "Ocultar" : "Mostrar")</button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(erro))
            {
                <div class="notice error" role="alert">@erro</div>
            }

            <button class="primary-button login-submit" type="submit" disabled="@entrando">
                @(entrando ? "Conectando…" : "Entrar") <span aria-hidden="true">→</span>
            </button>
        </EditForm>

        <div class="demo-hint">
            <span class="hint-icon">i</span>
            <div><strong>Acesso CATCHAT</strong><br />Entre com e-mail ou apelido aprovado por Zeus.<br />Use a senha criada pelo convite recebido por e-mail.</div>
        </div>
        <p class="prototype-label">Mensagens e mídias sincronizadas diretamente com o Supabase.</p>
        <p class="login-register"><button class="text-button" type="button" @onclick="AbrirRecuperacao">Esqueci minha senha</button> · <a href="/solicitar-acesso">Solicitar acesso</a></p>
        }
    </section>
    <aside class="login-side">
        <div class="side-content">
            <span class="side-kicker">CATCHAT</span>
            <h2>Suas conversas,<br />também na web.</h2>
            <p>Use o mesmo acesso do aplicativo no iPhone, iPad ou computador.</p>
            <div class="side-stats"><span>✉</span><div><strong>Mensagens sincronizadas</strong><small>Conversas conectadas à sua conta</small></div></div>
        </div>
        <div class="side-orbit orbit-one"></div><div class="side-orbit orbit-two"></div>
    </aside>
</main>

@code {
    private readonly LoginForm form = new();
    private bool mostrarSenha;
    private bool entrando;
    private bool modoRecuperacao;
    private bool modoSolicitarRecuperacao;
    private bool solicitandoRecuperacao;
    private bool salvandoSenha;
    private bool senhaAtualizada;
    private bool modoConfirmarEmail;
    private bool emailCadastroConfirmado;
    private string? erro;
    private string? mensagemRecuperacao;
    private readonly NovaSenhaForm novaSenhaForm = new();

    protected override void OnInitialized()
    {
        var currentUri = Navigation.ToAbsoluteUri(Navigation.Uri);
        modoSolicitarRecuperacao = currentUri.Query.Contains("recovery=1", StringComparison.OrdinalIgnoreCase);
        modoConfirmarEmail = currentUri.Query.Contains("confirmarEmail=1", StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            if (modoConfirmarEmail)
            {
                await Portal.ConfirmarEmailCadastroAsync();
                emailCadastroConfirmado = true;
                StateHasChanged();
                return;
            }
            modoRecuperacao = await Portal.EstaEmRecuperacaoSenhaAsync();
            if (modoRecuperacao)
            {
                StateHasChanged();
                return;
            }
            if (Portal.Autenticado)
            {
                Navigation.NavigateTo("/main", replace: true);
                return;
            }
            if (await Portal.RestaurarSessaoAsync())
                Navigation.NavigateTo("/main", replace: true);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            erro = ex.Message;
            StateHasChanged();
        }
    }

    private void AbrirRecuperacao()
    {
        erro = null;
        mensagemRecuperacao = null;
        modoSolicitarRecuperacao = true;
    }

    private void VoltarAoLogin()
    {
        erro = null;
        mensagemRecuperacao = null;
        modoSolicitarRecuperacao = false;
    }

    private async Task SolicitarRecuperacaoAsync()
    {
        erro = null;
        mensagemRecuperacao = null;
        solicitandoRecuperacao = true;
        try
        {
            await Portal.SolicitarRedefinicaoSenhaAsync(form.Email);
            mensagemRecuperacao = "Se o e-mail estiver cadastrado, você receberá um link para redefinir a senha.";
        }
        catch (InvalidOperationException ex)
        {
            erro = ex.Message;
        }
        finally
        {
            solicitandoRecuperacao = false;
        }
    }

    private async Task SalvarNovaSenhaAsync()
    {
        erro = null;
        if (novaSenhaForm.Senha.Length < 8)
        {
            erro = "A nova senha deve ter pelo menos 8 caracteres.";
            return;
        }
        if (!string.Equals(novaSenhaForm.Senha, novaSenhaForm.Confirmacao, StringComparison.Ordinal))
        {
            erro = "As senhas não coincidem.";
            return;
        }

        salvandoSenha = true;
        try
        {
            await Portal.AtualizarSenhaAsync(novaSenhaForm.Senha);
            novaSenhaForm.Senha = "";
            novaSenhaForm.Confirmacao = "";
            modoRecuperacao = false;
            senhaAtualizada = true;
        }
        catch (InvalidOperationException ex)
        {
            erro = ex.Message;
        }
        finally
        {
            salvandoSenha = false;
        }
    }

    private async Task EntrarAsync()
    {
        if (entrando)
            return;

        erro = null;
        if (string.IsNullOrWhiteSpace(form.Email) || string.IsNullOrWhiteSpace(form.Senha))
        {
            erro = "Informe seu e-mail e sua senha.";
            return;
        }


        entrando = true;
        try
        {
            await Portal.EntrarAsync(form.Email, form.Senha);
            form.Senha = "";
            Navigation.NavigateTo("/main");
        }
        catch (InvalidOperationException ex)
        {
            erro = ex.Message;
        }
        catch (JSException)
        {
            erro = "Não foi possível iniciar o acesso neste navegador. Confira se o JavaScript está habilitado.";
        }
        finally
        {
            entrando = false;
        }
    }

    private sealed class LoginForm
    {
        public string Email { get; set; } = "";
        public string Senha { get; set; } = "";
    }

    private sealed class NovaSenhaForm
    {
        public string Senha { get; set; } = "";
        public string Confirmacao { get; set; } = "";
    }
}


