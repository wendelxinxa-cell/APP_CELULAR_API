@page "/aprovacoes"
@using Microsoft.JSInterop
@using WebPrototype.Services
@inject ChatPortalState Portal
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Aprovações · CATCHAT</PageTitle>

@if (carregando)
{
    <div class="page-loading">Carregando usuários e aparelhos pendentes…</div>
}
else if (Portal.Autenticado && Portal.EhZeus)
{
    <main class="home-shell">
        <header class="home-topbar"><a class="wordmark chatcat-wordmark" href="/main"><img src="catchat_official.png" alt="" /> CATCHAT</a><a href="/main">Voltar</a></header>
        <section class="home-content">
            <p class="eyebrow">ADMINISTRAÇÃO</p>
            <div class="managed-users-heading"><h1>Aprovações</h1><button class="secondary-button" type="button" @onclick="AtualizarAsync" disabled="@processando">Atualizar</button></div>
            <p class="home-intro">Cada pedido mostra o usuário e o aparelho juntos. Ao aprovar, o usuário pendente é liberado e o aparelho fica vinculado a ele.</p>
            @if (!string.IsNullOrWhiteSpace(aviso)) { <div class="notice @(falha ? "error" : "success")" role="status">@aviso</div> }
            <section class="managed-users">
                <h2>Solicitações de acesso da conta</h2>
                @if (acessos.Count == 0)
                {
                    <div class="home-unavailable"><strong>Nenhuma solicitação de acesso pendente</strong><p>Solicitações criadas pelo fluxo legado também aparecem aqui.</p></div>
                }
                else
                {
                    @foreach (var acesso in acessos)
                    {
                        <article class="access-request" @key="acesso.AuthUid">
                            <div><strong>@acesso.Nome</strong><small>@acesso.Email · Empresa @acesso.EmpresaId</small><small>@acesso.NomeDispositivo · Pedido em @acesso.CriadaEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></div>
                            <div class="request-actions">
                                <button class="primary-button" @onclick="() => AprovarAcessoAsync(acesso)" disabled="@processando">Aprovar acesso</button>
                                <button class="secondary-button" @onclick="() => RecusarAcessoAsync(acesso)" disabled="@processando">Recusar</button>
                            </div>
                        </article>
                    }
                }
            </section>
            <section class="managed-users">
                <h2>Cadastros aguardando aprovação</h2>
                @if (cadastros.Count == 0)
                {
                    <div class="home-unavailable"><strong>Nenhum cadastro pendente</strong><p>Pedidos aparecem aqui assim que são criados, inclusive enquanto aguardam confirmação do e-mail.</p></div>
                }
                else
                {
                    @foreach (var cadastro in cadastros)
                    {
                        <article class="access-request" @key="cadastro.Id">
                            <div><strong>@cadastro.Nome</strong><small>@cadastro.Email</small><small>@NomeEmpresa(cadastro.EmpresaId) · Pedido em @cadastro.CriadaEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                                @if (!cadastro.EmailVerificado) { <small class="managed-user-role">Aguardando confirmação do e-mail; a aprovação fica bloqueada até a confirmação.</small> }
                            </div>
                            <div class="request-actions">
                                <select aria-label="Usuário CATCHAT para vincular" @bind="cadastro.UsuarioIdSelecionado" disabled="@processando">
                                    <option value="0">Selecione o usuário CATCHAT</option>
                                    @foreach (var user in usuariosEmpresa.Where(user => user.EmpresaId == cadastro.EmpresaId))
                                    {
                                        <option value="@user.Id">@user.Nome · @user.Funcao</option>
                                    }
                                </select>
                                <button class="primary-button" @onclick="() => AprovarCadastroAsync(cadastro)" disabled="@(processando || !cadastro.EmailVerificado || cadastro.UsuarioIdSelecionado <= 0)">Aprovar e enviar criação de senha</button>
                                <button class="secondary-button" @onclick="() => RecusarCadastroAsync(cadastro)" disabled="@processando">Recusar</button>
                            </div>
                        </article>
                    }
                }
            </section>
            <section class="managed-users">
                <h2>Usuários e aparelhos pendentes</h2>
                @if (solicitacoes.Count == 0)
                {
                    <div class="home-unavailable"><strong>Nenhum usuário ou aparelho pendente</strong><p>Novos pedidos aparecerão aqui automaticamente.</p></div>
                }
                else
                {
                    @foreach (var item in solicitacoes)
                    {
                        <article class="access-request" @key="item.DispositivoId ?? item.UsuarioPendenteId">
                            <div><strong>@item.Usuario</strong><small>@item.Dispositivo</small><small>@item.Tipo · @NomeEmpresa(item.EmpresaId, item.Empresa)</small>
                                @if (item.CriadoEm.HasValue) { <small>Pedido em @item.CriadoEm.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small> }
                            </div>
                            <div class="request-actions">
                                @if (item.SemDispositivo) { <span class="managed-user-role">Aguardando aparelho</span> }
                                else { <button class="primary-button" @onclick="() => AprovarAsync(item)" disabled="@processando">Aprovar vínculo</button> }
                            </div>
                        </article>
                    }
                }
            </section>
        </section>
    </main>
}

@code {
    private List<AprovacaoUsuarioAparelho> solicitacoes = [];
    private List<SolicitacaoAcesso> acessos = [];
    private List<CadastroPendente> cadastros = [];
    private List<UsuarioEmpresaDisponivel> usuariosEmpresa = [];
    private bool carregando = true;
    private bool processando;
    private bool falha;
    private string? aviso;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            if (!Portal.Autenticado) await Portal.RestaurarSessaoAsync();
            if (!Portal.Autenticado) { Navigation.NavigateTo("/login", replace: true); return; }
            if (!Portal.EhZeus) { Navigation.NavigateTo("/main", replace: true); return; }
            await AtualizarAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException)
        {
            falha = true;
            aviso = ex.Message;
        }
        finally { carregando = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task AtualizarAsync()
    {
        try
        {
            solicitacoes = await Portal.ListarUsuariosAparelhosPendentesAsync();
            acessos = await Portal.ListarSolicitacoesAsync();
            cadastros = await Portal.ListarCadastrosPendentesAsync();
            usuariosEmpresa = await Portal.ListarUsuariosEmpresaAsync();
            aviso = null;
            falha = false;
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException)
        {
            falha = true;
            aviso = ex.Message;
        }
    }

    private async Task AprovarCadastroAsync(CadastroPendente item)
    {
        var user = usuariosEmpresa.FirstOrDefault(user => user.Id == item.UsuarioIdSelecionado && user.EmpresaId == item.EmpresaId);
        if (user is null) { falha = true; aviso = "Selecione um usuário CATCHAT da mesma empresa do pedido."; return; }
        if (!await JS.InvokeAsync<bool>("confirm", $"Aprovar {item.Nome} ({item.Email}) e vincular a {user.Nome}, empresa {user.Empresa}? O link para criar a senha será enviado por e-mail.")) return;
        processando = true; aviso = null; falha = false;
        try { await Portal.AprovarCadastroAsync(item.Id, user.Id); aviso = $"Cadastro aprovado e link para criar a senha enviado para {item.Email}."; await AtualizarAsync(); }
        catch (Exception ex) when (ex is InvalidOperationException or JSException) { falha = true; aviso = ex.Message; }
        finally { processando = false; }
    }

    private async Task AprovarAcessoAsync(SolicitacaoAcesso item)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Aprovar o acesso de {item.Nome} ({item.Email}) na empresa {item.EmpresaId}?")) return;
        processando = true; aviso = null; falha = false;
        try { await Portal.AprovarSolicitacaoAsync(item); aviso = $"Acesso liberado para {item.Nome}."; await AtualizarAsync(); }
        catch (Exception ex) when (ex is InvalidOperationException or JSException) { falha = true; aviso = ex.Message; }
        finally { processando = false; }
    }

    private async Task RecusarAcessoAsync(SolicitacaoAcesso item)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Recusar o acesso de {item.Nome} ({item.Email})?")) return;
        processando = true; aviso = null; falha = false;
        try { await Portal.RecusarSolicitacaoAsync(item.AuthUid); aviso = "Solicitação recusada."; await AtualizarAsync(); }
        catch (Exception ex) when (ex is InvalidOperationException or JSException) { falha = true; aviso = ex.Message; }
        finally { processando = false; }
    }

    private string NomeEmpresa(long empresaId, string? nomeInformado = null)
    {
        if (!string.IsNullOrWhiteSpace(nomeInformado)) return nomeInformado;
        var user = usuariosEmpresa.FirstOrDefault(item => item.EmpresaId == empresaId);
        return string.IsNullOrWhiteSpace(user?.Empresa) ? "Empresa vinculada" : user.Empresa;
    }

    private async Task RecusarCadastroAsync(CadastroPendente item)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Recusar o cadastro de {item.Nome} ({item.Email})?")) return;
        processando = true; aviso = null; falha = false;
        try { await Portal.RecusarCadastroAsync(item.Id); aviso = "Cadastro recusado."; await AtualizarAsync(); }
        catch (Exception ex) when (ex is InvalidOperationException or JSException) { falha = true; aviso = ex.Message; }
        finally { processando = false; }
    }

    private async Task AprovarAsync(AprovacaoUsuarioAparelho item)
    {
        var resumo = $"Usuário: {item.Usuario}\nAparelho: {item.Dispositivo}\nEmpresa: {NomeEmpresa(item.EmpresaId, item.Empresa)}";
        if (!await JS.InvokeAsync<bool>("confirm", $"Aprovar este vínculo?\n\n{resumo}\n\nO aparelho anterior do usuário poderá ser desativado.")) return;
        processando = true;
        aviso = null;
        falha = false;
        try
        {
            await Portal.AprovarUsuarioAparelhoAsync(item);
            aviso = "Vínculo aprovado.";
            await AtualizarAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException)
        {
            falha = true;
            aviso = ex.Message;
        }
        finally { processando = false; }
    }
}
