@page "/aprovacoes"
@using Microsoft.JSInterop
@using WebPrototype.Services
@inject ChatPortalState Portal
@inject NavigationManager Navigation

<PageTitle>Solicitações de acesso · CATCHAT</PageTitle>

@if (carregando)
{
    <div class="page-loading">Carregando solicitações…</div>
}
else if (Portal.Autenticado && Portal.EhZeus)
{
    <main class="home-shell">
        <header class="home-topbar"><a class="wordmark chatcat-wordmark" href="/main"><img src="app-icon-512.png" alt="" /> CATCHAT</a><a href="/main">Voltar</a></header>
        <section class="home-content">
            <p class="eyebrow">ADMINISTRAÇÃO</p>
            <h1>Solicitações de acesso</h1>
            <p class="home-intro">Confira username, e-mail e aparelho. O ID será gerado pelo banco; selecione a modalidade para aprovar.</p>
            @if (!string.IsNullOrWhiteSpace(aviso)) { <div class="notice @(falha ? "error" : "success")" role="status">@aviso</div> }
            @if (solicitacoes.Count == 0)
            {
                <div class="home-unavailable"><strong>Nenhuma solicitação pendente</strong><p>Novos pedidos enviados aparecerão aqui.</p></div>
            }
            else
            {
                @foreach (var item in solicitacoes)
                {
                    <article class="access-request" @key="item.AuthUid">
                        <div><strong>@item.Username</strong><small>@item.Email</small><small>Empresa @item.EmpresaId · Aparelho: @item.NomeDispositivo</small><small>Enviada em @item.CriadaEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></div>
                        <label class="request-user-id">Tipo de empresa
                            <select @bind="tiposNegocio[item.AuthUid]">
                                <option value="comercial">Comercial</option>
                                <option value="chat">Chat</option>
                            </select>
                        </label>
                        @if (item.DispositivoId is null) { <small class="notice error">Este pedido antigo não tem aparelho vinculado; solicite um novo acesso pelo aparelho.</small> }
                        <div class="request-actions"><button class="primary-button" @onclick="() => AprovarAsync(item)" disabled="@(processando || item.DispositivoId is null)">Aprovar</button><button class="danger-button" @onclick="() => RecusarAsync(item)" disabled="@processando">Recusar</button></div>
                    </article>
                }
            }
        </section>
    </main>
}

@code {
    private List<SolicitacaoAcesso> solicitacoes = [];
    private readonly Dictionary<string, string> tiposNegocio = [];
    private bool carregando = true;
    private bool processando;
    private bool falha;
    private string? aviso;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            if (!Portal.Autenticado) await Portal.RestaurarSessaoAsync();
            if (!Portal.Autenticado) { Navigation.NavigateTo("/login", replace: true); return; }
            if (!Portal.EhZeus) { Navigation.NavigateTo("/main", replace: true); return; }
            await AtualizarAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException)
        {
            falha = true;
            aviso = ex.Message;
        }
        finally { carregando = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task AtualizarAsync()
    {
        solicitacoes = await Portal.ListarSolicitacoesAsync();
        foreach (var item in solicitacoes) tiposNegocio.TryAdd(item.AuthUid, "comercial");
    }

    private async Task AprovarAsync(SolicitacaoAcesso item)
    {
        if (item.DispositivoId is null)
        {
            falha = true; aviso = "Esse pedido não tem aparelho vinculado. Peça ao usuário para enviar uma nova solicitação."; return;
        }
        if (!tiposNegocio.TryGetValue(item.AuthUid, out var tipoNegocio) || tipoNegocio is not ("comercial" or "chat"))
        {
            falha = true; aviso = "Selecione comercial ou chat antes de aprovar."; return;
        }
        await ProcessarAsync(async () => await Portal.AprovarSolicitacaoAsync(item.AuthUid, item.EmpresaId, tipoNegocio), "Usuário e aparelho aprovados.");
    }

    private Task RecusarAsync(SolicitacaoAcesso item) => ProcessarAsync(() => Portal.RecusarSolicitacaoAsync(item.AuthUid), "Solicitação recusada.");

    private async Task ProcessarAsync(Func<Task> acao, string sucesso)
    {
        processando = true; aviso = null; falha = false;
        try { await acao(); aviso = sucesso; await AtualizarAsync(); }
        catch (Exception ex) when (ex is InvalidOperationException or JSException) { falha = true; aviso = ex.Message; }
        finally { processando = false; }
    }
}
