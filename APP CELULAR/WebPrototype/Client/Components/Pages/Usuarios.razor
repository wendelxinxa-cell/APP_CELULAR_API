@page "/usuarios"
@using Microsoft.JSInterop
@using WebPrototype.Services
@inject ChatPortalState Portal
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Usuários · CATCHAT</PageTitle>

@if (carregando)
{
    <div class="page-loading">Carregando usuários…</div>
}
else if (Portal.Autenticado && Portal.EhZeus)
{
    <main class="home-shell">
        <header class="home-topbar">
            <a class="wordmark chatcat-wordmark" href="/main"><img src="catchat_official.png" alt="" /> CATCHAT</a>
            <a href="/main">Voltar</a>
        </header>
        <section class="home-content users-admin">
            <p class="eyebrow">ADMINISTRAÇÃO</p>
            <h1>Usuários</h1>
            <p class="home-intro">Convide pessoas, vincule a conta Supabase ao usuário existente do CATCHAT e controle o acesso.</p>

            @if (!string.IsNullOrWhiteSpace(aviso))
            {
                <div class="notice @(falha ? "error" : "success")" role="status">@aviso</div>
            }

            <section class="user-invite-card">
                <h2>Convidar usuário</h2>
                <p>O Supabase envia o convite para o e-mail informado. A pessoa define a própria senha pelo link.</p>
                <EditForm Model="form" OnValidSubmit="ConvidarAsync">
                    <div class="user-invite-grid">
                        <label>Nome<input @bind="form.Nome" maxlength="120" autocomplete="name" required /></label>
                        <label>E-mail<input @bind="form.Email" type="email" maxlength="254" autocomplete="email" required /></label>
                        @if (!form.Master)
                        {
                            <label>Usuário CATCHAT para vincular
                                <select @bind="form.UsuarioId" required>
                                    <option value="0">Selecione pelo nome</option>
                                    @foreach (var user in usuariosEmpresa.Where(user => user.EmpresaId == Portal.Sessao!.EmpresaId))
                                    {
                                        <option value="@user.Id">@user.Nome · @user.Funcao</option>
                                    }
                                </select>
                            </label>
                        }
                    </div>
                    <label class="user-master-choice">
                        <input @bind="form.Master" type="checkbox" />
                        <span><strong>Conta Zeus master global</strong><small>Concede controle administrativo das funções já migradas para este projeto Supabase.</small></span>
                    </label>
                    @if (form.Master)
                    {
                        <p class="user-admin-note">A função master inclui as funções de chat e solicitações migradas. Módulos ainda mantidos na API, como clientes, produtos e vendas, não são adicionados por esta tela.</p>
                    }
                    <button class="primary-button" type="submit" disabled="@processando">@(processando ? "Enviando convite…" : "Convidar e vincular")</button>
                </EditForm>
            </section>

            <section class="managed-users">
                <div class="managed-users-heading"><h2>Contas no Supabase</h2><button class="secondary-button" type="button" @onclick="AtualizarAsync" disabled="@processando">Atualizar</button></div>
                @if (usuarios.Count == 0)
                {
                    <div class="home-unavailable"><strong>Nenhuma conta vinculada</strong><p>Convites e cadastros aprovados aparecerão nesta lista.</p></div>
                }
                else
                {
                    @foreach (var usuario in usuarios)
                    {
                        <article class="managed-user" @key="usuario.AuthUid">
                            <div class="managed-user-copy">
                                <strong>@usuario.Nome</strong>
                                <small>@usuario.Email</small>
                                <small>@EstadoUsuario(usuario)</small>
                            </div>
                            <span class="managed-user-role">@(usuario.Master ? "ZEUS MASTER" : usuario.UsuarioId.HasValue ? "USUÁRIO VINCULADO" : "SEM VÍNCULO")</span>
                            @if (!usuario.Master)
                            {
                                <button class="secondary-button" type="button" @onclick="() => AlterarMasterAsync(usuario, true)" disabled="@processando">Tornar master</button>
                                <button class="@(usuario.Ativo ? "danger-button" : "primary-button")" type="button" @onclick="() => AlterarAtivoAsync(usuario, !usuario.Ativo)" disabled="@processando">@(usuario.Ativo ? "Bloquear" : "Ativar")</button>
                            }
                            else if (usuario.AuthUid != Portal.Sessao!.SupabaseUserId)
                            {
                                <button class="danger-button" type="button" @onclick="() => AlterarMasterAsync(usuario, false)" disabled="@processando">Remover master</button>
                            }
                            @if (!string.IsNullOrWhiteSpace(usuario.Email))
                            {
                                <button class="secondary-button" type="button" @onclick="() => SolicitarRedefinicaoAsync(usuario.Email)" disabled="@processando">Redefinir senha</button>
                            }
                        </article>
                    }
                }
            </section>
            <section class="managed-users">
                <div class="managed-users-heading"><h2>Usuários cadastrados nas empresas</h2><button class="secondary-button" type="button" @onclick="AtualizarAsync" disabled="@processando">Atualizar</button></div>
                @if (usuariosEmpresa.Count == 0)
                {
                    <div class="home-unavailable"><strong>Nenhum usuário cadastrado</strong><p>Os usuários das empresas aparecerão nesta lista.</p></div>
                }
                else
                {
                    @foreach (var usuario in usuariosEmpresa)
                    {
                        <article class="managed-user" @key="usuario.Id">
                            <div class="managed-user-copy">
                                <strong>@usuario.Nome</strong>
                                <small>@usuario.Funcao · @(usuario.TipoNegocio == "chat" ? "Chat" : "Comercial")</small>
                                <small>@(string.IsNullOrWhiteSpace(usuario.Empresa) ? $"Empresa · código {usuario.EmpresaId}" : $"Empresa: {usuario.Empresa} · código {usuario.EmpresaId}")</small>
                                @if (!string.IsNullOrWhiteSpace(usuario.Email)) { <small>@usuario.Email</small> }
                                <small>@EstadoUsuario(usuario)</small>
                            </div>
                            <span class="managed-user-role">@(usuario.Bloqueado ? "BLOQUEADO" : usuario.Aprovado ? "LIBERADO" : "PENDENTE")</span>
                            <button class="secondary-button" type="button" @onclick="() => IniciarEdicao(usuario)" disabled="@processando">Editar</button>
                            <button class="@(usuario.Bloqueado ? "primary-button" : "danger-button")" type="button" @onclick="() => AlterarUsuarioEmpresaAtivoAsync(usuario, usuario.Bloqueado)" disabled="@processando">@(usuario.Bloqueado ? "Ativar" : "Desativar")</button>
                            @if (!string.IsNullOrWhiteSpace(usuario.Email))
                            {
                                <button class="secondary-button" type="button" @onclick="() => SolicitarRedefinicaoAsync(usuario.Email)" disabled="@processando">Redefinir senha</button>
                            }
                            @if (editandoId == usuario.Id)
                            {
                                <EditForm Model="edicao" OnValidSubmit="SalvarEdicaoAsync" @key="usuario.Id">
                                    <div class="user-invite-grid">
                                        <label>E-mail<input @bind="edicao.Email" type="email" maxlength="254" required /></label>
                                        <label>Nome<input @bind="edicao.Nome" maxlength="120" required /></label>
                                        <label>Tipo de acesso<select @bind="edicao.TipoNegocio"><option value="chat">Chat</option><option value="comercial">Comercial</option></select></label>
                                    </div>
                                    <button class="primary-button" type="submit" disabled="@processando">Salvar alterações</button>
                                    <button class="secondary-button" type="button" @onclick="CancelarEdicao">Cancelar</button>
                                </EditForm>
                            }
                        </article>
                    }
                }
            </section>
        </section>
    </main>
}

@code {
    private readonly ConviteForm form = new();
    private List<UsuarioAuthGerenciavel> usuarios = [];
    private List<UsuarioEmpresaDisponivel> usuariosEmpresa = [];
    private bool carregando = true;
    private bool processando;
    private bool falha;
    private string? aviso;
    private long? editandoId;
    private UsuarioEmpresaEdicao edicao = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            if (!Portal.Autenticado) await Portal.RestaurarSessaoAsync();
            if (!Portal.Autenticado) { Navigation.NavigateTo("/login", replace: true); return; }
            if (!Portal.EhZeus) { Navigation.NavigateTo("/main", replace: true); return; }
            await AtualizarAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException)
        {
            falha = true;
            aviso = ex.Message;
        }
        finally { carregando = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task AtualizarAsync()
    {
        try
        {
            usuarios = await Portal.ListarUsuariosGerenciaveisAsync();
            usuariosEmpresa = await Portal.ListarUsuariosEmpresaAsync();
            aviso = null;
            falha = false;
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException)
        {
            aviso = ex.Message;
            falha = true;
        }
    }

    private async Task ConvidarAsync()
    {
        if (processando) return;
        var email = form.Email.Trim();
        var nome = form.Nome.Trim();
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(nome) || (!form.Master && form.UsuarioId <= 0))
        {
            falha = true;
            aviso = form.Master ? "Informe nome e e-mail válidos." : "Informe nome, e-mail e selecione o usuário CATCHAT pelo nome.";
            return;
        }
        var user = form.Master ? null : usuariosEmpresa.FirstOrDefault(user => user.Id == form.UsuarioId && user.EmpresaId == Portal.Sessao!.EmpresaId);
        if (!form.Master && user is null) { falha = true; aviso = "Selecione um usuário CATCHAT disponível nesta empresa."; return; }
        var descricaoAcesso = form.Master
            ? $"Enviar convite para {email} e conceder a função Zeus master global no Supabase?"
            : $"Enviar convite para {email} e vinculá-lo ao usuário CATCHAT {user!.Nome}?";
        if (!await JS.InvokeAsync<bool>("confirm", descricaoAcesso)) return;

        processando = true;
        aviso = null;
        falha = false;
        try
        {
            await Portal.ConvidarUsuarioAsync(email, nome, form.Master, Portal.Sessao!.EmpresaId, form.Master ? null : form.UsuarioId);
            aviso = form.Master
                ? $"Convite enviado para {email}; a função master global foi ativada. A pessoa deverá definir a própria senha pelo e-mail."
                : $"Convite enviado para {email} e vinculado a {user!.Nome}. A pessoa deverá definir a própria senha pelo e-mail.";
            form.Nome = "";
            form.Email = "";
            form.UsuarioId = 0;
            form.Master = false;
            usuarios = await Portal.ListarUsuariosGerenciaveisAsync();
            usuariosEmpresa = await Portal.ListarUsuariosEmpresaAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException)
        {
            falha = true;
            aviso = ex.Message;
        }
        finally { processando = false; }
    }

    private async Task AlterarMasterAsync(UsuarioAuthGerenciavel usuario, bool ativo)
    {
        var acao = ativo ? "conceder acesso Zeus master" : "remover o acesso Zeus master";
        if (!await JS.InvokeAsync<bool>("confirm", $"Confirma {acao} para {usuario.Email}?")) return;
        await ProcessarAsync(async () => await Portal.DefinirUsuarioMasterAsync(usuario.AuthUid, ativo), "Acesso master atualizado.");
    }

    private async Task AlterarAtivoAsync(UsuarioAuthGerenciavel usuario, bool ativo)
    {
        var pergunta = ativo && !usuario.UsuarioId.HasValue
            ? $"Reabrir a solicitação de acesso de {usuario.Email}?"
            : $"Confirma {(ativo ? "reativar" : "bloquear")} a conta de {usuario.Email}?";
        if (!await JS.InvokeAsync<bool>("confirm", pergunta)) return;
        var sucesso = ativo && !usuario.UsuarioId.HasValue
            ? "Solicitação reaberta. Vincule esta conta a um usuário CATCHAT para liberar o acesso completo."
            : ativo ? "Acesso do usuário reativado." : "Acesso do usuário bloqueado.";
        await ProcessarAsync(async () => await Portal.DefinirUsuarioAtivoAsync(usuario.AuthUid, ativo), sucesso);
    }

    private async Task ProcessarAsync(Func<Task> acao, string sucesso)
    {
        processando = true;
        aviso = null;
        falha = false;
        try
        {
            await acao();
            await AtualizarAsync();
            if (!string.IsNullOrWhiteSpace(aviso)) falha = true;
            else { aviso = sucesso; falha = false; }
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException) { falha = true; aviso = ex.Message; }
        finally { processando = false; }
    }

    private static string EstadoUsuario(UsuarioAuthGerenciavel usuario) =>
        usuario.Master ? "Acesso Zeus master ativo" : usuario.Ativo ? usuario.UsuarioId.HasValue ? "Ativo" : "Solicitação pendente · sem vínculo" : "Acesso desativado";

    private static string EstadoUsuario(UsuarioEmpresaDisponivel usuario) =>
        usuario.Bloqueado ? "Acesso desativado" : usuario.Aprovado ? "Ativo" : usuario.AparelhoPendente ? "Aguardando aprovação do aparelho" : "Pendente";

    private void IniciarEdicao(UsuarioEmpresaDisponivel usuario)
    {
        editandoId = usuario.Id;
        edicao = new UsuarioEmpresaEdicao { Id = usuario.Id, EmpresaId = usuario.EmpresaId, Username = usuario.Username, Email = usuario.Email, Nome = usuario.Nome, TipoNegocio = usuario.TipoNegocio };
        aviso = null;
    }

    private void CancelarEdicao() => editandoId = null;

    private async Task SalvarEdicaoAsync()
    {
        var username = edicao.Username.Trim();
        var email = edicao.Email.Trim();
        var nome = edicao.Nome.Trim();
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(nome))
        {
            falha = true; aviso = "Este usuário ainda não tem identidade vinculada para edição. Confira o cadastro e tente novamente."; return;
        }
        if (!await JS.InvokeAsync<bool>("confirm", $"Salvar nome e e-mail para este usuário?")) return;
        await ProcessarAsync(async () => await Portal.EditarUsuarioEmpresaAsync(edicao.EmpresaId, edicao.Id, username, email, nome, edicao.TipoNegocio), "Dados do usuário atualizados no banco.");
        if (!falha) editandoId = null;
    }

    private async Task AlterarUsuarioEmpresaAtivoAsync(UsuarioEmpresaDisponivel usuario, bool ativo)
    {
        var acao = ativo ? "ativar" : "desativar";
        if (!await JS.InvokeAsync<bool>("confirm", $"Confirma {acao} o usuário {usuario.Nome}?")) return;
        await ProcessarAsync(async () => await Portal.DefinirUsuarioEmpresaAtivoAsync(usuario.EmpresaId, usuario.Id, ativo), ativo ? "Usuário ativado." : "Usuário desativado.");
    }

    private async Task SolicitarRedefinicaoAsync(string emailInformado)
    {
        var email = emailInformado.Trim();
        if (string.IsNullOrWhiteSpace(email)) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"Enviar para {email} um link seguro para definir uma nova senha?")) return;
        await ProcessarAsync(async () => await Portal.SolicitarRedefinicaoSenhaAsync(email), $"Link para redefinir a senha enviado para {email}.");
    }

    private sealed class UsuarioEmpresaEdicao
    {
        public long Id { get; set; }
        public long EmpresaId { get; set; }
        public string Username { get; set; } = "";
        public string Email { get; set; } = "";
        public string Nome { get; set; } = "";
        public string TipoNegocio { get; set; } = "comercial";
    }

    private sealed class ConviteForm
    {
        public string Nome { get; set; } = "";
        public string Email { get; set; } = "";
        public long UsuarioId { get; set; }
        public bool Master { get; set; }
    }
}
