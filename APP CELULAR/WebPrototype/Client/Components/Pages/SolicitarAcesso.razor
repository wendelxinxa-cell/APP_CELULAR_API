@page "/solicitar-acesso"
@using Microsoft.JSInterop
@using WebPrototype.Services
@inject ChatPortalState Portal
@inject NavigationManager Navigation

<PageTitle>Solicitar acesso · CATCHAT</PageTitle>

<main class="login-page">
    <section class="login-card">
        <div class="brand-mark" aria-hidden="true">😺</div>
        <p class="eyebrow">CATCHAT</p>
        <h1>Solicitar acesso</h1>
        <p class="muted login-intro">Informe o username que usará para entrar, seu e-mail e uma senha. A empresa será identificada automaticamente. Confirme o e-mail para Zeus receber o pedido em Pendências.</p>

        @if (enviado)
        {
            <div class="notice success" role="status">Pedido registrado. Confirme o e-mail; depois Zeus poderá aprovar seu acesso em Pendências. Use o username e a senha escolhidos para entrar após a aprovação.</div>
            <a class="primary-button login-submit" href="/login">Voltar ao login</a>
        }
        else
        {
            <EditForm Model="form" OnValidSubmit="EnviarAsync">
                <div class="field"><label for="request-name">Username</label><input id="request-name" @bind="form.Nome" autocomplete="username" maxlength="120" required /></div>
                <div class="field"><label for="request-email">E-mail</label><input id="request-email" type="email" @bind="form.Email" autocomplete="email" required /></div>
                <div class="field"><label for="request-password">Senha</label><input id="request-password" type="password" @bind="form.Senha" autocomplete="new-password" minlength="8" maxlength="72" required /></div>
                <div class="field"><label for="request-password-confirm">Confirme a senha</label><input id="request-password-confirm" type="password" @bind="form.ConfirmacaoSenha" autocomplete="new-password" minlength="8" maxlength="72" required /></div>
                @if (!string.IsNullOrWhiteSpace(erro)) { <div class="notice error" role="alert">@erro</div> }
                <button class="primary-button login-submit" type="submit" disabled="@enviando">@(enviando ? "Enviando…" : "Enviar solicitação")</button>
            </EditForm>
            <p class="login-register"><a href="/login">Já tenho acesso</a></p>
        }
    </section>
</main>

@code {
    private readonly RequestForm form = new();
    private bool enviando;
    private bool enviado;
    private string? erro;

    private async Task EnviarAsync()
    {
        if (enviando) return;
        enviando = true;
        erro = null;
        try
        {
            if (!string.Equals(form.Senha, form.ConfirmacaoSenha, StringComparison.Ordinal))
            {
                erro = "As senhas não coincidem.";
                return;
            }
            await Portal.SolicitarAcessoAsync(form.Email, form.Nome, form.Senha);
            enviado = true;
            form.Senha = "";
            form.ConfirmacaoSenha = "";
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException)
        {
            erro = ex.Message;
        }
        finally { enviando = false; }
    }

    private sealed class RequestForm
    {
        public string Nome { get; set; } = "";
        public string Email { get; set; } = "";
        public string Senha { get; set; } = "";
        public string ConfirmacaoSenha { get; set; } = "";
    }
}
