@page "/solicitar-acesso"
@using Microsoft.JSInterop
@using WebPrototype.Services
@inject ChatPortalState Portal
@inject NavigationManager Navigation

<PageTitle>Solicitar acesso · CATCHAT</PageTitle>

<main class="login-page">
    <section class="login-card">
        <div class="brand-mark" aria-hidden="true">😺</div>
        <p class="eyebrow">CATCHAT</p>
        <h1>Solicitar acesso</h1>
        <p class="muted login-intro">Informe seu nome, e-mail e crie sua senha. Confirme o e-mail; Zeus definirá a empresa, o tipo de negócio e o vínculo antes de liberar o acesso.</p>

        @if (enviado)
        {
            <div class="notice success" role="status">Cadastro registrado. Confira sua caixa de entrada e confirme o e-mail. Zeus verá o pedido em Pendências e definirá a empresa, o tipo de negócio e o vínculo. Se não encontrar, confira o spam.</div>
            <a class="primary-button login-submit" href="/login">Voltar ao login</a>
        }
        else
        {
            <EditForm Model="form" OnValidSubmit="EnviarAsync">
                <div class="field"><label for="request-name">Nome</label><input id="request-name" @bind="form.Nome" autocomplete="name" maxlength="120" required /></div>
                <div class="field"><label for="request-email">E-mail</label><input id="request-email" type="email" @bind="form.Email" autocomplete="email" required /></div>
                <div class="field"><label for="request-password">Crie uma senha</label><input id="request-password" type="password" @bind="form.Senha" autocomplete="new-password" minlength="8" required /></div>
                <div class="field"><label for="request-password-confirm">Confirme a senha</label><input id="request-password-confirm" type="password" @bind="form.ConfirmarSenha" autocomplete="new-password" minlength="8" required /></div>
                @if (!string.IsNullOrWhiteSpace(erro)) { <div class="notice error" role="alert">@erro</div> }
                <button class="primary-button login-submit" type="submit" disabled="@enviando">@(enviando ? "Enviando…" : "Enviar solicitação")</button>
            </EditForm>
            <p class="login-register"><a href="/login">Já tenho acesso</a></p>
        }
    </section>
</main>

@code {
    private readonly RequestForm form = new();
    private bool enviando;
    private bool enviado;
    private string? erro;

    private async Task EnviarAsync()
    {
        if (enviando) return;
        enviando = true;
        erro = null;
        try
        {
            if (form.Senha.Length < 8) throw new InvalidOperationException("A senha deve ter pelo menos 8 caracteres.");
            if (!string.Equals(form.Senha, form.ConfirmarSenha, StringComparison.Ordinal))
                throw new InvalidOperationException("As senhas não conferem.");
            await Portal.SolicitarAcessoAsync(form.Email, form.Nome, form.Senha);
            enviado = true;
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException)
        {
            erro = ex.Message;
        }
        finally { enviando = false; }
    }

    private sealed class RequestForm
    {
        public string Nome { get; set; } = "";
        public string Email { get; set; } = "";
        public string Senha { get; set; } = "";
        public string ConfirmarSenha { get; set; } = "";
    }
}
