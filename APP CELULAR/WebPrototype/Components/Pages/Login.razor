@page "/"
@page "/login"
@using System.Globalization
@using Microsoft.JSInterop
@using WebPrototype.Services
@inject ChatPortalState Portal
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IJSRuntime JS

<PageTitle>Entrar · ChatCat</PageTitle>

<main class="login-page">
    <section class="login-card">
        <div class="brand-mark" aria-hidden="true">😺</div>
        <p class="eyebrow">CHATCAT · APP CELULAR</p>
        <h1>Acesso ao sistema</h1>
        <p class="muted login-intro">Entre com sua conta do aplicativo para acessar suas conversas.</p>

        <EditForm Model="form" OnValidSubmit="EntrarAsync">
            <div class="field">
                <label for="username">Usuário</label>
                <input id="username" @bind="form.Usuario" autocomplete="username" placeholder="Digite seu usuário" />
            </div>
            <div class="field">
                <label for="password">Senha</label>
                <div class="password-field">
                    <input id="password" type="@(mostrarSenha ? "text" : "password")" @bind="form.Senha" autocomplete="current-password" placeholder="Digite sua senha" />
                    <button class="reveal-button" type="button" @onclick="() => mostrarSenha = !mostrarSenha" aria-label="Mostrar ou ocultar senha">@(mostrarSenha ? "Ocultar" : "Mostrar")</button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(erro))
            {
                <div class="notice error" role="alert">@erro</div>
            }

            <button class="primary-button login-submit" type="submit" disabled="@entrando">
                @(entrando ? "Conectando…" : "Entrar") <span aria-hidden="true">→</span>
            </button>
        </EditForm>

        <div class="demo-hint">
            <span class="hint-icon">i</span>
            <div><strong>Conta do APP CELULAR</strong><br />Empresa configurada: @EmpresaId<br />Se este navegador for novo, o administrador pode precisar aprová-lo.</div>
        </div>
        <p class="prototype-label">Mensagens e contatos carregados do serviço usado pelo aplicativo.</p>
    </section>
    <aside class="login-side">
        <div class="side-content">
            <span class="side-kicker">CHATCAT</span>
            <h2>Suas conversas,<br />também na web.</h2>
            <p>Use o mesmo acesso do aplicativo no iPhone, iPad ou computador.</p>
            <div class="side-stats"><span>✉</span><div><strong>Mensagens sincronizadas</strong><small>Conversas conectadas à sua conta</small></div></div>
        </div>
        <div class="side-orbit orbit-one"></div><div class="side-orbit orbit-two"></div>
    </aside>
</main>

@code {
    private readonly LoginForm form = new();
    private bool mostrarSenha;
    private bool entrando;
    private string? erro;
    private long EmpresaId => Configuration.GetValue<long>("Api:EmpresaId", 1);

    private async Task EntrarAsync()
    {
        erro = null;
        if (string.IsNullOrWhiteSpace(form.Usuario) || string.IsNullOrWhiteSpace(form.Senha))
        {
            erro = "Informe seu usuário e sua senha.";
            return;
        }

        if (EmpresaId <= 0)
        {
            erro = "A empresa do serviço não está configurada.";
            return;
        }

        entrando = true;
        try
        {
            var chaveTexto = await JS.InvokeAsync<string>("appCelular.getOrCreateInstallationId");
            if (!Guid.TryParse(chaveTexto, out var chaveInstalacao) || chaveInstalacao == Guid.Empty)
                throw new InvalidOperationException("Não foi possível identificar este navegador. Recarregue a página e tente novamente.");

            await Portal.EntrarAsync(EmpresaId, form.Usuario, form.Senha, chaveInstalacao);
            form.Senha = "";
            Navigation.NavigateTo("/conversas");
        }
        catch (InvalidOperationException ex)
        {
            erro = ex.Message;
        }
        catch (JSException)
        {
            erro = "Não foi possível iniciar o acesso neste navegador. Confira se o JavaScript está habilitado.";
        }
        finally
        {
            entrando = false;
        }
    }

    private sealed class LoginForm
    {
        public string Usuario { get; set; } = "";
        public string Senha { get; set; } = "";
    }
}
