<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#111111" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ChatCat" />
    <base href="/" />
    <link rel="manifest" href="site.webmanifest" />
    <link rel="apple-touch-icon" href="apple-touch-icon-180.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="app-icon-512.png" />
    <link rel="icon" type="image/svg+xml" href="app-icon.svg" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="WebPrototype.styles.css" />
    <link rel="stylesheet" href="chatcat-theme.css?v=attention-rounded" />
    <link rel="stylesheet" href="main.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <div id="components-reconnect-modal" role="status" aria-live="polite">
        <section class="reconnect-card">
            <div class="reconnect-cat" aria-hidden="true">😺</div>
            <p class="reconnect-retrying">Reconectando ao ChatCat…</p>
            <p class="reconnect-paused">A conexão foi pausada. Voltando ao ChatCat…</p>
            <p class="reconnect-failed">Não foi possível reconectar agora.</p>
            <p class="reconnect-rejected">O serviço reiniciou. Sua sessão será recuperada se ainda estiver válida.</p>
            <button class="primary-button reconnect-reload" type="button" onclick="location.reload()">Reabrir ChatCat</button>
        </section>
    </div>
    <script src="device-id.js"></script>
    <script src="chat.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
