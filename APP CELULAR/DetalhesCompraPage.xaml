<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="APP_CELULAR.DetalhesCompraPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{DynamicResource BrandBackground}"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <!-- CABEÇALHO -->
        <Grid
            Grid.Row="0"
            Padding="16,14"
            BackgroundColor="{DynamicResource BrandPrimary}"
            ColumnDefinitions="Auto,*,Auto">

            <Button
                Grid.Column="0"
                Text="‹"
                FontSize="34"
                TextColor="{DynamicResource BrandOnPrimary}"
                BackgroundColor="Transparent"
                Padding="0"
                WidthRequest="45"
                HeightRequest="45"
                Clicked="Voltar_Clicked" />

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="1"
                VerticalOptions="Center">

                <Label
                    x:Name="TituloLabel"
                    Text="Compra"
                    FontSize="21"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource BrandOnPrimary}" />

                <Label
                    Text="Detalhes da entrada"
                    FontSize="13"
                    TextColor="{DynamicResource BrandOnPrimary}" />

                <Label x:Name="UsuarioLogadoLabel" FontSize="10" TextColor="{DynamicResource BrandOnPrimary}" />

            </VerticalStackLayout>

            <Label
                Grid.Column="2"
                Text="🛒"
                FontSize="27"
                VerticalOptions="Center"
                HorizontalOptions="End" />

        </Grid>

        <!-- CONTEÚDO -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="16,18,16,30"
                Spacing="14">

                <!-- INFORMAÇÕES DA COMPRA -->
                <Border
                    BackgroundColor="{DynamicResource BrandSurface}"
                    Stroke="{DynamicResource BrandBorder}"
                    StrokeThickness="1"
                    Padding="16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Grid.Column="0" Spacing="2">

                                <Label
                                    Text="COMPRA"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource BrandMuted}" />

                                <Label
                                    x:Name="NumeroCompraLabel"
                                    Text="Compra #000"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource BrandPrimary}" />

                            </VerticalStackLayout>

                            <Border
                                x:Name="StatusBorder"
                                Grid.Column="1"
                                Padding="12,7"
                                VerticalOptions="Center"
                                BackgroundColor="{DynamicResource BrandSoft}">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Label
                                    x:Name="StatusLabel"
                                    Text="AGUARDANDO..."
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#2463B5" />

                            </Border>

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="{DynamicResource BrandSoft}" />

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">

                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="Fornecedor:"
                                FontSize="13"
                                TextColor="{DynamicResource BrandMuted}" />

                            <Label
                                x:Name="FornecedorLabel"
                                Grid.Row="0"
                                Grid.Column="1"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource BrandText}"
                                HorizontalTextAlignment="End" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="Data:"
                                FontSize="13"
                                TextColor="{DynamicResource BrandMuted}" />

                            <Label
                                x:Name="DataLabel"
                                Grid.Row="1"
                                Grid.Column="1"
                                FontSize="14"
                                TextColor="{DynamicResource BrandText}"
                                HorizontalTextAlignment="End" />

                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="Total:"
                                FontSize="13"
                                TextColor="{DynamicResource BrandMuted}" />

                            <Label
                                x:Name="TotalLabel"
                                Grid.Row="2"
                                Grid.Column="1"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource BrandPrimary}"
                                HorizontalTextAlignment="End" />

                        </Grid>

                        <VerticalStackLayout
                            x:Name="ObservacaoLayout"
                            Spacing="4"
                            IsVisible="False">

                            <BoxView
                                HeightRequest="1"
                                BackgroundColor="{DynamicResource BrandSoft}" />

                            <Label
                                Text="Observação"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource BrandMuted}" />

                            <Label
                                x:Name="ObservacaoLabel"
                                FontSize="14"
                                TextColor="{DynamicResource BrandText}" />

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>


                <!-- TÍTULO DOS ITENS -->
                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="1">

                        <Label
                            Text="Materiais"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource BrandPrimary}" />

                        <Label
                            x:Name="OrientacaoLabel"
                            Text="Informe a perda de cada material"
                            FontSize="12"
                            TextColor="{DynamicResource BrandMuted}" />

                    </VerticalStackLayout>

                    <Label
                        x:Name="QuantidadeItensLabel"
                        Grid.Column="1"
                        FontSize="13"
                        TextColor="{DynamicResource BrandMuted}"
                        VerticalOptions="Center" />

                </Grid>


                <!-- ITENS -->
                <VerticalStackLayout
                    x:Name="ItensLayout"
                    Spacing="12" />


                <!-- RESUMO -->
                <Border
                    BackgroundColor="{DynamicResource BrandSurface}"
                    Stroke="{DynamicResource BrandBorder}"
                    StrokeThickness="1"
                    Padding="16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">

                        <Label
                            Text="Resumo da entrada"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource BrandPrimary}" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Peso bruto:"
                                FontSize="13"
                                TextColor="{DynamicResource BrandMuted}" />

                            <Label
                                x:Name="PesoBrutoLabel"
                                Grid.Column="1"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource BrandText}" />

                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Perda:"
                                FontSize="13"
                                TextColor="#C62828" />

                            <Label
                                x:Name="PerdaTotalLabel"
                                Grid.Column="1"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#C62828" />

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="{DynamicResource BrandSoft}" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Quantidade líquida:"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource BrandText}" />

                            <Label
                                x:Name="QuantidadeLiquidaLabel"
                                Grid.Column="1"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="#16803C" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>


                <!-- BOTÕES -->
                <Button
                    x:Name="BtnConcluir"
                    Text="✓  INFORMAR PERDAS E CONCLUIR"
                    FontSize="15"
                    FontAttributes="Bold"
                    HeightRequest="52"
                    CornerRadius="12"
                    BackgroundColor="#16803C"
                    TextColor="White"
                    Clicked="Concluir_Clicked" />

                <Button
                    x:Name="BtnCancelar"
                    Text="Cancelar compra"
                    FontSize="14"
                    HeightRequest="48"
                    CornerRadius="12"
                    BackgroundColor="#FFE0E0"
                    TextColor="#C62828"
                    Clicked="Cancelar_Clicked" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
